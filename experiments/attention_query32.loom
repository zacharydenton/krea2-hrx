  %out_halves0 = vector.fragment.repack<rhs> %out_fragment0 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out1 = vector.divf<nnan|ninf|nsz|arcp> %final1, %selected_sum : vector<8xf32>
  %out_fragment1 = vector.fragment<result> %out1 shape [%m, %n] : vector<8xf32>
  %out_halves1 = vector.fragment.repack<rhs> %out_fragment1 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out2 = vector.divf<nnan|ninf|nsz|arcp> %final2, %selected_sum : vector<8xf32>
  %out_fragment2 = vector.fragment<result> %out2 shape [%m, %n] : vector<8xf32>
  %out_halves2 = vector.fragment.repack<rhs> %out_fragment2 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out3 = vector.divf<nnan|ninf|nsz|arcp> %final3, %selected_sum : vector<8xf32>
  %out_fragment3 = vector.fragment<result> %out3 shape [%m, %n] : vector<8xf32>
  %out_halves3 = vector.fragment.repack<rhs> %out_fragment3 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out4 = vector.divf<nnan|ninf|nsz|arcp> %final4, %selected_sum : vector<8xf32>
  %out_fragment4 = vector.fragment<result> %out4 shape [%m, %n] : vector<8xf32>
  %out_halves4 = vector.fragment.repack<rhs> %out_fragment4 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out5 = vector.divf<nnan|ninf|nsz|arcp> %final5, %selected_sum : vector<8xf32>
  %out_fragment5 = vector.fragment<result> %out5 shape [%m, %n] : vector<8xf32>
  %out_halves5 = vector.fragment.repack<rhs> %out_fragment5 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out6 = vector.divf<nnan|ninf|nsz|arcp> %final6, %selected_sum : vector<8xf32>
  %out_fragment6 = vector.fragment<result> %out6 shape [%m, %n] : vector<8xf32>
  %out_halves6 = vector.fragment.repack<rhs> %out_fragment6 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out7 = vector.divf<nnan|ninf|nsz|arcp> %final7, %selected_sum : vector<8xf32>
  %out_fragment7 = vector.fragment<result> %out7 shape [%m, %n] : vector<8xf32>
  %out_halves7 = vector.fragment.repack<rhs> %out_fragment7 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %query_in_sequence = index.cmp ult, %query_row0, %tokens0 : index
  %query_in_output = index.cmp ult, %query_row0, %token_count : index
  %query_present = scalar.andi %query_in_sequence, %query_in_output : i1
  %publish = scalar.andi %query_present, %lane_group_even : i1
  scf.if %publish {
    %out_row0 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col0_0 = index.add %head_base0, %c0 : index
    %out_last0 = index.sub %out_stride0, %c16 : index
    %out_col0 = index.assume %out_col0_0 [le(%out_col0_0, %out_last0), mul(%out_col0_0, 16)] : index
    vector.store %out_halves0, %out_view[%out_row0, %out_col0] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row1 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col1_0 = index.add %head_base0, %c16 : index
    %out_last1 = index.sub %out_stride0, %c16 : index
    %out_col1 = index.assume %out_col1_0 [le(%out_col1_0, %out_last1), mul(%out_col1_0, 16)] : index
    vector.store %out_halves1, %out_view[%out_row1, %out_col1] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row2 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col2_0 = index.add %head_base0, %c32 : index
    %out_last2 = index.sub %out_stride0, %c16 : index
    %out_col2 = index.assume %out_col2_0 [le(%out_col2_0, %out_last2), mul(%out_col2_0, 16)] : index
    vector.store %out_halves2, %out_view[%out_row2, %out_col2] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row3 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col3_0 = index.add %head_base0, %c48 : index
    %out_last3 = index.sub %out_stride0, %c16 : index
    %out_col3 = index.assume %out_col3_0 [le(%out_col3_0, %out_last3), mul(%out_col3_0, 16)] : index
    vector.store %out_halves3, %out_view[%out_row3, %out_col3] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row4 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col4_0 = index.add %head_base0, %c64 : index
    %out_last4 = index.sub %out_stride0, %c16 : index
    %out_col4 = index.assume %out_col4_0 [le(%out_col4_0, %out_last4), mul(%out_col4_0, 16)] : index
    vector.store %out_halves4, %out_view[%out_row4, %out_col4] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row5 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col5_0 = index.add %head_base0, %c80 : index
    %out_last5 = index.sub %out_stride0, %c16 : index
    %out_col5 = index.assume %out_col5_0 [le(%out_col5_0, %out_last5), mul(%out_col5_0, 16)] : index
    vector.store %out_halves5, %out_view[%out_row5, %out_col5] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row6 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col6_0 = index.add %head_base0, %c96 : index
    %out_last6 = index.sub %out_stride0, %c16 : index
    %out_col6 = index.assume %out_col6_0 [le(%out_col6_0, %out_last6), mul(%out_col6_0, 16)] : index
    vector.store %out_halves6, %out_view[%out_row6, %out_col6] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row7 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col7_0 = index.add %head_base0, %c112 : index
    %out_last7 = index.sub %out_stride0, %c16 : index
    %out_col7 = index.assume %out_col7_0 [le(%out_col7_0, %out_last7), mul(%out_col7_0, 16)] : index
    vector.store %out_halves7, %out_view[%out_row7, %out_col7] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
  }
  kernel.return
}
