  }
  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  %q_channel0 = index.add %head_base0, %c0 : index
  %q_hoist0 = vector.load %q_view[%query_row, %q_channel0] : view<[%padded_tokens]x[%q_stride0]xf16> -> vector<16xf16>
  %lhs0 = vector.fragment<rhs> %q_hoist0 shape [%k_frag, %n] : vector<16xf16>
  %q_channel1 = index.add %head_base0, %c16 : index
  %q_hoist1 = vector.load %q_view[%query_row, %q_channel1] : view<[%padded_tokens]x[%q_stride0]xf16> -> vector<16xf16>
  %lhs1 = vector.fragment<rhs> %q_hoist1 shape [%k_frag, %n] : vector<16xf16>
  %q_channel2 = index.add %head_base0, %c32 : index
  %q_hoist2 = vector.load %q_view[%query_row, %q_channel2] : view<[%padded_tokens]x[%q_stride0]xf16> -> vector<16xf16>
  %lhs2 = vector.fragment<rhs> %q_hoist2 shape [%k_frag, %n] : vector<16xf16>
  %q_channel3 = index.add %head_base0, %c48 : index
  %q_hoist3 = vector.load %q_view[%query_row, %q_channel3] : view<[%padded_tokens]x[%q_stride0]xf16> -> vector<16xf16>
  %lhs3 = vector.fragment<rhs> %q_hoist3 shape [%k_frag, %n] : vector<16xf16>
  %final_max, %final_sum, %final0, %final1, %final2, %final3, %final4, %final5, %final6, %final7 = scf.for %key_tile = [%c0 to %key_tile_count step %c1](%row_max = %negative_large : f32, %row_sum = %zero_f32 : f32, %acc0 = %init : vector<8xf32>, %acc1 = %init : vector<8xf32>, %acc2 = %init : vector<8xf32>, %acc3 = %init : vector<8xf32>, %acc4 = %init : vector<8xf32>, %acc5 = %init : vector<8xf32>, %acc6 = %init : vector<8xf32>, %acc7 = %init : vector<8xf32>) -> (f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>) {
    %key_origin1 = index.mul %key_tile, %c16 : index
    %key_origin0 = index.assume %key_origin1 [le(%key_origin1, %tile_origin_limit), mul(%key_origin1, 16)] : index
    // stage K and V tiles (rows past the sequence are zero headroom)
    %st_row0 = index.add %key_origin0, %st_key : index
    %st_row = index.assume %st_row0 [lt(%st_row0, %padded_tokens)] : index
    %k_chunk = vector.load %k_view[%st_row, %st_col] : view<[%padded_tokens]x[%kv_stride0]xf16> -> vector<16xf16>
    %st_row_v0 = index.add %key_origin0, %st_key_v : index
    %st_row_v = index.assume %st_row_v0 [lt(%st_row_v0, %padded_tokens)] : index
    %v_chunk = vector.load %v_view[%st_row_v, %st_col_v] : view<[%padded_tokens]x[%kv_stride0]xf16> -> vector<16xf16>
    vector.store %k_chunk, %k_tile[%st_key, %st_chunk] : vector<16xf16>, view<16x136xf16>
    %ve0 = vector.extract %v_chunk[0] : vector<16xf16> -> f16
    %vr0 = index.add %st_chunk_v, %cj0 : index
    view.store %ve0, %v_tile[%vr0, %st_key_v] : f16, view<128x24xf16>
    %ve1 = vector.extract %v_chunk[1] : vector<16xf16> -> f16
    %vr1 = index.add %st_chunk_v, %cj1 : index
    view.store %ve1, %v_tile[%vr1, %st_key_v] : f16, view<128x24xf16>
    %ve2 = vector.extract %v_chunk[2] : vector<16xf16> -> f16
    %vr2 = index.add %st_chunk_v, %cj2 : index
    view.store %ve2, %v_tile[%vr2, %st_key_v] : f16, view<128x24xf16>
    %ve3 = vector.extract %v_chunk[3] : vector<16xf16> -> f16
    %vr3 = index.add %st_chunk_v, %cj3 : index
    view.store %ve3, %v_tile[%vr3, %st_key_v] : f16, view<128x24xf16>
    %ve4 = vector.extract %v_chunk[4] : vector<16xf16> -> f16
    %vr4 = index.add %st_chunk_v, %cj4 : index
    view.store %ve4, %v_tile[%vr4, %st_key_v] : f16, view<128x24xf16>
    %ve5 = vector.extract %v_chunk[5] : vector<16xf16> -> f16
    %vr5 = index.add %st_chunk_v, %cj5 : index
    view.store %ve5, %v_tile[%vr5, %st_key_v] : f16, view<128x24xf16>
    %ve6 = vector.extract %v_chunk[6] : vector<16xf16> -> f16
    %vr6 = index.add %st_chunk_v, %cj6 : index
    view.store %ve6, %v_tile[%vr6, %st_key_v] : f16, view<128x24xf16>
    %ve7 = vector.extract %v_chunk[7] : vector<16xf16> -> f16
    %vr7 = index.add %st_chunk_v, %cj7 : index
    view.store %ve7, %v_tile[%vr7, %st_key_v] : f16, view<128x24xf16>
    %ve8 = vector.extract %v_chunk[8] : vector<16xf16> -> f16
    %vr8 = index.add %st_chunk_v, %cj8 : index
    view.store %ve8, %v_tile[%vr8, %st_key_v] : f16, view<128x24xf16>
    %ve9 = vector.extract %v_chunk[9] : vector<16xf16> -> f16
    %vr9 = index.add %st_chunk_v, %cj9 : index
    view.store %ve9, %v_tile[%vr9, %st_key_v] : f16, view<128x24xf16>
    %ve10 = vector.extract %v_chunk[10] : vector<16xf16> -> f16
    %vr10 = index.add %st_chunk_v, %cj10 : index
    view.store %ve10, %v_tile[%vr10, %st_key_v] : f16, view<128x24xf16>
    %ve11 = vector.extract %v_chunk[11] : vector<16xf16> -> f16
    %vr11 = index.add %st_chunk_v, %cj11 : index
    view.store %ve11, %v_tile[%vr11, %st_key_v] : f16, view<128x24xf16>
    %ve12 = vector.extract %v_chunk[12] : vector<16xf16> -> f16
    %vr12 = index.add %st_chunk_v, %cj12 : index
    view.store %ve12, %v_tile[%vr12, %st_key_v] : f16, view<128x24xf16>
    %ve13 = vector.extract %v_chunk[13] : vector<16xf16> -> f16
    %vr13 = index.add %st_chunk_v, %cj13 : index
    view.store %ve13, %v_tile[%vr13, %st_key_v] : f16, view<128x24xf16>
    %ve14 = vector.extract %v_chunk[14] : vector<16xf16> -> f16
    %vr14 = index.add %st_chunk_v, %cj14 : index
    view.store %ve14, %v_tile[%vr14, %st_key_v] : f16, view<128x24xf16>
    %ve15 = vector.extract %v_chunk[15] : vector<16xf16> -> f16
    %vr15 = index.add %st_chunk_v, %cj15 : index
    view.store %ve15, %v_tile[%vr15, %st_key_v] : f16, view<128x24xf16>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %local_key = index.add %key_origin0, %lane_column : index
    %key_valid = index.cmp ult, %local_key, %tokens0 : index
    %k_data0 = vector.load %k_tile[%lane_column, %c0] : view<16x136xf16> -> vector<16xf16>
    %rhs0 = vector.fragment<lhs> %k_data0 shape [%m, %k_frag] : vector<16xf16>
    %qk0 = vector.mma %rhs0, %lhs0, %init : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %k_data1 = vector.load %k_tile[%lane_column, %c16] : view<16x136xf16> -> vector<16xf16>
    %rhs1 = vector.fragment<lhs> %k_data1 shape [%m, %k_frag] : vector<16xf16>
    %qk1 = vector.mma %rhs1, %lhs1, %qk0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %k_data2 = vector.load %k_tile[%lane_column, %c32] : view<16x136xf16> -> vector<16xf16>
    %rhs2 = vector.fragment<lhs> %k_data2 shape [%m, %k_frag] : vector<16xf16>
    %qk2 = vector.mma %rhs2, %lhs2, %qk1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %k_data3 = vector.load %k_tile[%lane_column, %c48] : view<16x136xf16> -> vector<16xf16>
    %rhs3 = vector.fragment<lhs> %k_data3 shape [%m, %k_frag] : vector<16xf16>
    %qk3 = vector.mma %rhs3, %lhs3, %qk2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %q_data4 = vector.load %q_tile[%lane_column, %c0] : view<16x72xf16> -> vector<16xf16>
    %lhs4 = vector.fragment<rhs> %q_data4 shape [%k_frag, %n] : vector<16xf16>
    %k_data4 = vector.load %k_tile[%lane_column, %c64] : view<16x136xf16> -> vector<16xf16>
    %rhs4 = vector.fragment<lhs> %k_data4 shape [%m, %k_frag] : vector<16xf16>
    %qk4 = vector.mma %rhs4, %lhs4, %qk3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %q_data5 = vector.load %q_tile[%lane_column, %c16] : view<16x72xf16> -> vector<16xf16>
    %lhs5 = vector.fragment<rhs> %q_data5 shape [%k_frag, %n] : vector<16xf16>
    %k_data5 = vector.load %k_tile[%lane_column, %c80] : view<16x136xf16> -> vector<16xf16>
    %rhs5 = vector.fragment<lhs> %k_data5 shape [%m, %k_frag] : vector<16xf16>
    %qk5 = vector.mma %rhs5, %lhs5, %qk4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %q_data6 = vector.load %q_tile[%lane_column, %c32] : view<16x72xf16> -> vector<16xf16>
    %lhs6 = vector.fragment<rhs> %q_data6 shape [%k_frag, %n] : vector<16xf16>
    %k_data6 = vector.load %k_tile[%lane_column, %c96] : view<16x136xf16> -> vector<16xf16>
    %rhs6 = vector.fragment<lhs> %k_data6 shape [%m, %k_frag] : vector<16xf16>
    %qk6 = vector.mma %rhs6, %lhs6, %qk5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %q_data7 = vector.load %q_tile[%lane_column, %c48] : view<16x72xf16> -> vector<16xf16>
    %lhs7 = vector.fragment<rhs> %q_data7 shape [%k_frag, %n] : vector<16xf16>
    %k_data7 = vector.load %k_tile[%lane_column, %c112] : view<16x136xf16> -> vector<16xf16>
    %rhs7 = vector.fragment<lhs> %k_data7 shape [%m, %k_frag] : vector<16xf16>
    %raw_scores = vector.mma %rhs7, %lhs7, %qk6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %scaled0 = vector.mulf %raw_scores, %scale_vector : vector<8xf32>
    %last_tile = index.sub %key_tile_count, %c1 : index
    %is_tail = index.cmp eq, %key_tile, %last_tile : index
    %scaled = scf.if %is_tail -> (vector<8xf32>) {
      %score0 = vector.extract %scaled0[0] : vector<8xf32> -> f32
      %key_relative0 = index.add %lane_group, %cj0 : index
      %key_absolute0 = index.add %key_origin0, %key_relative0 : index
      %key_present0 = index.cmp ult, %key_absolute0, %tokens0 : index
      %masked0 = scf.select %key_present0, %score0, %negative_large : f32
      %score1 = vector.extract %scaled0[1] : vector<8xf32> -> f32
      %key_relative1 = index.add %lane_group, %cj2 : index
      %key_absolute1 = index.add %key_origin0, %key_relative1 : index
      %key_present1 = index.cmp ult, %key_absolute1, %tokens0 : index
      %masked1 = scf.select %key_present1, %score1, %negative_large : f32
      %score2 = vector.extract %scaled0[2] : vector<8xf32> -> f32
      %key_relative2 = index.add %lane_group, %cj4 : index
      %key_absolute2 = index.add %key_origin0, %key_relative2 : index
      %key_present2 = index.cmp ult, %key_absolute2, %tokens0 : index
      %masked2 = scf.select %key_present2, %score2, %negative_large : f32
      %score3 = vector.extract %scaled0[3] : vector<8xf32> -> f32
      %key_relative3 = index.add %lane_group, %cj6 : index
      %key_absolute3 = index.add %key_origin0, %key_relative3 : index
      %key_present3 = index.cmp ult, %key_absolute3, %tokens0 : index
      %masked3 = scf.select %key_present3, %score3, %negative_large : f32
      %score4 = vector.extract %scaled0[4] : vector<8xf32> -> f32
      %key_relative4 = index.add %lane_group, %cj8 : index
      %key_absolute4 = index.add %key_origin0, %key_relative4 : index
      %key_present4 = index.cmp ult, %key_absolute4, %tokens0 : index
      %masked4 = scf.select %key_present4, %score4, %negative_large : f32
      %score5 = vector.extract %scaled0[5] : vector<8xf32> -> f32
      %key_relative5 = index.add %lane_group, %cj10 : index
      %key_absolute5 = index.add %key_origin0, %key_relative5 : index
      %key_present5 = index.cmp ult, %key_absolute5, %tokens0 : index
      %masked5 = scf.select %key_present5, %score5, %negative_large : f32
      %score6 = vector.extract %scaled0[6] : vector<8xf32> -> f32
      %key_relative6 = index.add %lane_group, %cj12 : index
      %key_absolute6 = index.add %key_origin0, %key_relative6 : index
      %key_present6 = index.cmp ult, %key_absolute6, %tokens0 : index
      %masked6 = scf.select %key_present6, %score6, %negative_large : f32
      %score7 = vector.extract %scaled0[7] : vector<8xf32> -> f32
      %key_relative7 = index.add %lane_group, %cj14 : index
      %key_absolute7 = index.add %key_origin0, %key_relative7 : index
      %key_present7 = index.cmp ult, %key_absolute7, %tokens0 : index
      %masked7 = scf.select %key_present7, %score7, %negative_large : f32
      %tail_scaled = vector.from_elements %masked0, %masked1, %masked2, %masked3, %masked4, %masked5, %masked6, %masked7 : vector<8xf32>
      scf.yield %tail_scaled : vector<8xf32>
    } else {
      scf.yield %scaled0 : vector<8xf32>
    }
    %local_max_element0 = vector.extract %scaled[0] : vector<8xf32> -> f32
    %local_max_element1 = vector.extract %scaled[1] : vector<8xf32> -> f32
    %local_max_element2 = vector.extract %scaled[2] : vector<8xf32> -> f32
    %local_max_element3 = vector.extract %scaled[3] : vector<8xf32> -> f32
    %local_max_element4 = vector.extract %scaled[4] : vector<8xf32> -> f32
    %local_max_element5 = vector.extract %scaled[5] : vector<8xf32> -> f32
    %local_max_element6 = vector.extract %scaled[6] : vector<8xf32> -> f32
    %local_max_element7 = vector.extract %scaled[7] : vector<8xf32> -> f32
    %local_max_0_0 = scalar.maxnumf %local_max_element0, %local_max_element1 : f32
    %local_max_0_1 = scalar.maxnumf %local_max_element2, %local_max_element3 : f32
    %local_max_0_2 = scalar.maxnumf %local_max_element4, %local_max_element5 : f32
    %local_max_0_3 = scalar.maxnumf %local_max_element6, %local_max_element7 : f32
    %local_max_1_0 = scalar.maxnumf %local_max_0_0, %local_max_0_1 : f32
    %local_max_1_1 = scalar.maxnumf %local_max_0_2, %local_max_0_3 : f32
    %local_max = scalar.maxnumf %local_max_1_0, %local_max_1_1 : f32
    %partner_max, %max_ok = kernel.subgroup.shuffle<xor> %local_max, %i32_16, %i32_32 : f32, i32, i32
    %tile_max = scalar.maxnumf %local_max, %partner_max : f32
    %next_max = scalar.maxnumf %row_max, %tile_max : f32
    %max_vector = vector.splat %next_max : vector<8xf32>
    %delta = vector.subf %scaled, %max_vector : vector<8xf32>
    %weight = vector.expf<afn> %delta : vector<8xf32>
    %old_delta = scalar.subf %row_max, %next_max : f32
    %old_scale = scalar.expf<afn> %old_delta : f32
    %old_scale_vector = vector.splat %old_scale : vector<8xf32>
    %local_sum_element0 = vector.extract %weight[0] : vector<8xf32> -> f32
    %local_sum_element1 = vector.extract %weight[1] : vector<8xf32> -> f32
    %local_sum_element2 = vector.extract %weight[2] : vector<8xf32> -> f32
    %local_sum_element3 = vector.extract %weight[3] : vector<8xf32> -> f32
    %local_sum_element4 = vector.extract %weight[4] : vector<8xf32> -> f32
    %local_sum_element5 = vector.extract %weight[5] : vector<8xf32> -> f32
    %local_sum_element6 = vector.extract %weight[6] : vector<8xf32> -> f32
    %local_sum_element7 = vector.extract %weight[7] : vector<8xf32> -> f32
    %local_sum_0_0 = scalar.addf %local_sum_element0, %local_sum_element1 : f32
    %local_sum_0_1 = scalar.addf %local_sum_element2, %local_sum_element3 : f32
    %local_sum_0_2 = scalar.addf %local_sum_element4, %local_sum_element5 : f32
    %local_sum_0_3 = scalar.addf %local_sum_element6, %local_sum_element7 : f32
    %local_sum_1_0 = scalar.addf %local_sum_0_0, %local_sum_0_1 : f32
    %local_sum_1_1 = scalar.addf %local_sum_0_2, %local_sum_0_3 : f32
    %local_sum = scalar.addf %local_sum_1_0, %local_sum_1_1 : f32
    %scaled_sum = scalar.mulf %row_sum, %old_scale : f32
    %next_sum = scalar.addf %scaled_sum, %local_sum : f32

    %weight_fragment = vector.fragment<result> %weight shape [%m, %n] : vector<8xf32>
    %probability = vector.fragment.repack<rhs> %weight_fragment shape [%k_frag, %n] : vector<8xf32> -> vector<16xf16>
    %vrow0 = index.add %lane_column, %c0 : index
    %v_data0 = vector.load %v_tile[%vrow0, %c0] : view<128x24xf16> -> vector<16xf16>
    %v0 = vector.fragment<lhs> %v_data0 shape [%m, %k_frag] : vector<16xf16>
    %rescaled0 = vector.mulf %acc0, %old_scale_vector : vector<8xf32>
    %next0 = vector.mma %v0, %probability, %rescaled0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow1 = index.add %lane_column, %c16 : index
    %v_data1 = vector.load %v_tile[%vrow1, %c0] : view<128x24xf16> -> vector<16xf16>
    %v1 = vector.fragment<lhs> %v_data1 shape [%m, %k_frag] : vector<16xf16>
    %rescaled1 = vector.mulf %acc1, %old_scale_vector : vector<8xf32>
    %next1 = vector.mma %v1, %probability, %rescaled1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow2 = index.add %lane_column, %c32 : index
    %v_data2 = vector.load %v_tile[%vrow2, %c0] : view<128x24xf16> -> vector<16xf16>
    %v2 = vector.fragment<lhs> %v_data2 shape [%m, %k_frag] : vector<16xf16>
    %rescaled2 = vector.mulf %acc2, %old_scale_vector : vector<8xf32>
    %next2 = vector.mma %v2, %probability, %rescaled2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow3 = index.add %lane_column, %c48 : index
    %v_data3 = vector.load %v_tile[%vrow3, %c0] : view<128x24xf16> -> vector<16xf16>
    %v3 = vector.fragment<lhs> %v_data3 shape [%m, %k_frag] : vector<16xf16>
    %rescaled3 = vector.mulf %acc3, %old_scale_vector : vector<8xf32>
    %next3 = vector.mma %v3, %probability, %rescaled3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
    %vrow4 = index.add %lane_column, %c64 : index
    %v_data4 = vector.load %v_tile[%vrow4, %c0] : view<128x24xf16> -> vector<16xf16>
    %v4 = vector.fragment<lhs> %v_data4 shape [%m, %k_frag] : vector<16xf16>
    %rescaled4 = vector.mulf %acc4, %old_scale_vector : vector<8xf32>
    %next4 = vector.mma %v4, %probability, %rescaled4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow5 = index.add %lane_column, %c80 : index
    %v_data5 = vector.load %v_tile[%vrow5, %c0] : view<128x24xf16> -> vector<16xf16>
    %v5 = vector.fragment<lhs> %v_data5 shape [%m, %k_frag] : vector<16xf16>
    %rescaled5 = vector.mulf %acc5, %old_scale_vector : vector<8xf32>
    %next5 = vector.mma %v5, %probability, %rescaled5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow6 = index.add %lane_column, %c96 : index
    %v_data6 = vector.load %v_tile[%vrow6, %c0] : view<128x24xf16> -> vector<16xf16>
    %v6 = vector.fragment<lhs> %v_data6 shape [%m, %k_frag] : vector<16xf16>
    %rescaled6 = vector.mulf %acc6, %old_scale_vector : vector<8xf32>
    %next6 = vector.mma %v6, %probability, %rescaled6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %vrow7 = index.add %lane_column, %c112 : index
    %v_data7 = vector.load %v_tile[%vrow7, %c0] : view<128x24xf16> -> vector<16xf16>
    %v7 = vector.fragment<lhs> %v_data7 shape [%m, %k_frag] : vector<16xf16>
    %rescaled7 = vector.mulf %acc7, %old_scale_vector : vector<8xf32>
    %next7 = vector.mma %v7, %probability, %rescaled7 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next_max, %next_sum, %next0, %next1, %next2, %next3, %next4, %next5, %next6, %next7 : f32, f32, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %partner_sum, %sum_ok = kernel.subgroup.shuffle<xor> %final_sum, %i32_16, %i32_32 : f32, i32, i32
  %total_sum = scalar.addf %final_sum, %partner_sum : f32
  %selected_sum = vector.splat %total_sum : vector<8xf32>
  %out0 = vector.divf<nnan|ninf|nsz|arcp> %final0, %selected_sum : vector<8xf32>
  %out_fragment0 = vector.fragment<result> %out0 shape [%m, %n] : vector<8xf32>
  %out_halves0 = vector.fragment.repack<rhs> %out_fragment0 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out1 = vector.divf<nnan|ninf|nsz|arcp> %final1, %selected_sum : vector<8xf32>
  %out_fragment1 = vector.fragment<result> %out1 shape [%m, %n] : vector<8xf32>
  %out_halves1 = vector.fragment.repack<rhs> %out_fragment1 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out2 = vector.divf<nnan|ninf|nsz|arcp> %final2, %selected_sum : vector<8xf32>
  %out_fragment2 = vector.fragment<result> %out2 shape [%m, %n] : vector<8xf32>
  %out_halves2 = vector.fragment.repack<rhs> %out_fragment2 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out3 = vector.divf<nnan|ninf|nsz|arcp> %final3, %selected_sum : vector<8xf32>
  %out_fragment3 = vector.fragment<result> %out3 shape [%m, %n] : vector<8xf32>
  %out_halves3 = vector.fragment.repack<rhs> %out_fragment3 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out4 = vector.divf<nnan|ninf|nsz|arcp> %final4, %selected_sum : vector<8xf32>
  %out_fragment4 = vector.fragment<result> %out4 shape [%m, %n] : vector<8xf32>
  %out_halves4 = vector.fragment.repack<rhs> %out_fragment4 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out5 = vector.divf<nnan|ninf|nsz|arcp> %final5, %selected_sum : vector<8xf32>
  %out_fragment5 = vector.fragment<result> %out5 shape [%m, %n] : vector<8xf32>
  %out_halves5 = vector.fragment.repack<rhs> %out_fragment5 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out6 = vector.divf<nnan|ninf|nsz|arcp> %final6, %selected_sum : vector<8xf32>
  %out_fragment6 = vector.fragment<result> %out6 shape [%m, %n] : vector<8xf32>
  %out_halves6 = vector.fragment.repack<rhs> %out_fragment6 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %out7 = vector.divf<nnan|ninf|nsz|arcp> %final7, %selected_sum : vector<8xf32>
  %out_fragment7 = vector.fragment<result> %out7 shape [%m, %n] : vector<8xf32>
  %out_halves7 = vector.fragment.repack<rhs> %out_fragment7 shape [%m, %n] : vector<8xf32> -> vector<16xf16>
  %query_in_sequence = index.cmp ult, %query_row0, %tokens0 : index
  %query_in_output = index.cmp ult, %query_row0, %token_count : index
  %query_present = scalar.andi %query_in_sequence, %query_in_output : i1
  %publish = scalar.andi %query_present, %lane_group_even : i1
  scf.if %publish {
    %out_row0 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col0_0 = index.add %head_base0, %c0 : index
    %out_last0 = index.sub %out_stride0, %c16 : index
    %out_col0 = index.assume %out_col0_0 [le(%out_col0_0, %out_last0), mul(%out_col0_0, 16)] : index
    vector.store %out_halves0, %out_view[%out_row0, %out_col0] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row1 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col1_0 = index.add %head_base0, %c16 : index
    %out_last1 = index.sub %out_stride0, %c16 : index
    %out_col1 = index.assume %out_col1_0 [le(%out_col1_0, %out_last1), mul(%out_col1_0, 16)] : index
    vector.store %out_halves1, %out_view[%out_row1, %out_col1] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row2 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col2_0 = index.add %head_base0, %c32 : index
    %out_last2 = index.sub %out_stride0, %c16 : index
    %out_col2 = index.assume %out_col2_0 [le(%out_col2_0, %out_last2), mul(%out_col2_0, 16)] : index
    vector.store %out_halves2, %out_view[%out_row2, %out_col2] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row3 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col3_0 = index.add %head_base0, %c48 : index
    %out_last3 = index.sub %out_stride0, %c16 : index
    %out_col3 = index.assume %out_col3_0 [le(%out_col3_0, %out_last3), mul(%out_col3_0, 16)] : index
    vector.store %out_halves3, %out_view[%out_row3, %out_col3] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row4 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col4_0 = index.add %head_base0, %c64 : index
    %out_last4 = index.sub %out_stride0, %c16 : index
    %out_col4 = index.assume %out_col4_0 [le(%out_col4_0, %out_last4), mul(%out_col4_0, 16)] : index
    vector.store %out_halves4, %out_view[%out_row4, %out_col4] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row5 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col5_0 = index.add %head_base0, %c80 : index
    %out_last5 = index.sub %out_stride0, %c16 : index
    %out_col5 = index.assume %out_col5_0 [le(%out_col5_0, %out_last5), mul(%out_col5_0, 16)] : index
    vector.store %out_halves5, %out_view[%out_row5, %out_col5] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row6 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col6_0 = index.add %head_base0, %c96 : index
    %out_last6 = index.sub %out_stride0, %c16 : index
    %out_col6 = index.assume %out_col6_0 [le(%out_col6_0, %out_last6), mul(%out_col6_0, 16)] : index
    vector.store %out_halves6, %out_view[%out_row6, %out_col6] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
    %out_row7 = index.assume %query_row0 [lt(%query_row0, %token_count)] : index
    %out_col7_0 = index.add %head_base0, %c112 : index
    %out_last7 = index.sub %out_stride0, %c16 : index
    %out_col7 = index.assume %out_col7_0 [le(%out_col7_0, %out_last7), mul(%out_col7_0, 16)] : index
    vector.store %out_halves7, %out_view[%out_row7, %out_col7] : vector<16xf16>, view<[%token_count]x[%out_stride0]xf16>
  }
  kernel.return
}
