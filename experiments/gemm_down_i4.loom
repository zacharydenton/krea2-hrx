      %farag1 = vector.fragment<lhs> %da1 shape [%m, %k] using {schema = %i4_schema : encoding<schema>} : vector<2xi32>
      %da2 = vector.load %a_stage[%fa2, %kq] : view<256x20xi32> -> vector<2xi32>
      %farag2 = vector.fragment<lhs> %da2 shape [%m, %k] using {schema = %i4_schema : encoding<schema>} : vector<2xi32>
      %da3 = vector.load %a_stage[%fa3, %kq] : view<256x20xi32> -> vector<2xi32>
      %farag3 = vector.fragment<lhs> %da3 shape [%m, %k] using {schema = %i4_schema : encoding<schema>} : vector<2xi32>
