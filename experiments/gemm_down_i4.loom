  %gw0 = vector.load %w_view[%w_row0, %kq_first] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>
  %gw1 = vector.load %w_view[%w_row1, %kq_first] : view<[%n_size]x[%k_quads]xi32> -> vector<4xi32>

  %acc00, %acc01, %acc02, %acc03, %acc10, %acc11, %acc12, %acc13, %acc20, %acc21, %acc22, %acc23, %acc30, %acc31, %acc32, %acc33, %a_last0, %a_last1, %a_last2, %a_last3, %w_last0, %w_last1 = scf.for %k_base = [%c0 to %k_size step %c128](%r00 = %acc_init : vector<8xi32>, %r01 = %acc_init : vector<8xi32>, %r02 = %acc_init : vector<8xi32>, %r03 = %acc_init : vector<8xi32>, %r10 = %acc_init : vector<8xi32>, %r11 = %acc_init : vector<8xi32>, %r12 = %acc_init : vector<8xi32>, %r13 = %acc_init : vector<8xi32>, %r20 = %acc_init : vector<8xi32>, %r21 = %acc_init : vector<8xi32>, %r22 = %acc_init : vector<8xi32>, %r23 = %acc_init : vector<8xi32>, %r30 = %acc_init : vector<8xi32>, %r31 = %acc_init : vector<8xi32>, %r32 = %acc_init : vector<8xi32>, %r33 = %acc_init : vector<8xi32>, %ca0 = %ga0 : vector<4xi32>, %ca1 = %ga1 : vector<4xi32>, %ca2 = %ga2 : vector<4xi32>, %ca3 = %ga3 : vector<4xi32>, %cw0 = %gw0 : vector<4xi32>, %cw1 = %gw1 : vector<4xi32>) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>, vector<4xi32>) {
