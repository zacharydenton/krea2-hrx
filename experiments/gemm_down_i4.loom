    }
    %load_a2 = scalar.andi %in_k, %a_ok2 : i1
    %na2 = scf.if %load_a2 -> (vector<4xi32>) {
      %v = vector.load %a_view[%a_row2, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
      scf.yield %v : vector<4xi32>
    } else {
