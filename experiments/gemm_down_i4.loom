    }

    %o00_7, %o01_7, %o02_7, %o03_7, %o10_7, %o11_7, %o12_7, %o13_7, %o20_7, %o21_7, %o22_7, %o23_7, %o30_7, %o31_7, %o32_7, %o33_7 = scf.for %kq = [%c0 to %c16 step %c2](%h00 = %r00 : vector<8xi32>, %h01 = %r01 : vector<8xi32>, %h02 = %r02 : vector<8xi32>, %h03 = %r03 : vector<8xi32>, %h10 = %r10 : vector<8xi32>, %h11 = %r11 : vector<8xi32>, %h12 = %r12 : vector<8xi32>, %h13 = %r13 : vector<8xi32>, %h20 = %r20 : vector<8xi32>, %h21 = %r21 : vector<8xi32>, %h22 = %r22 : vector<8xi32>, %h23 = %r23 : vector<8xi32>, %h30 = %r30 : vector<8xi32>, %h31 = %r31 : vector<8xi32>, %h32 = %r32 : vector<8xi32>, %h33 = %r33 : vector<8xi32>) -> (vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>, vector<8xi32>) unroll {
