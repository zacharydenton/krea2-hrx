      %db2 = vector.load %w_stage[%fb2, %kq] : view<128x20xi32> -> vector<2xi32>
      %fbrag2 = vector.fragment<rhs> %db2 shape [%m, %k] using {schema = %i4_schema : encoding<schema>} : vector<2xi32>
