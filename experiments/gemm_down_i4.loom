// gfx1151 Krea feed-forward down projection: W4A4 K=16384, N=6144.
// 256x128 workgroups, eight 64x64 wave tiles. Each W operand feeds twice
// as many accumulators as in the 128x128 kernel; A reuse is unchanged.
// One padded LDS stage; global packets are prefetched one K=128 step ahead.
// Four-row raster groups shorten at the tail, so no ghost workgroups run.
// Residual arithmetic and FP16 rounding match gemm_i4_resid.loom.
// Adapted from the loom-gemm / MiniMax H3 256x128 tile.
amdgpu.target<gfx11-generic> @krea2_gemm_down_i4_gfx11 {subgroup_size = 32}

kernel.def target(@krea2_gemm_down_i4_gfx11) export("krea2_gemm_down_i4") @krea2_gemm_down_i4(%m_size: index) {
  %c1 = index.constant 1 : index
  %c128 = index.constant 128 : index
  %c255 = index.constant 255 : index
  %c256 = index.constant 256 : index
  %n_size0 = index.constant 6144 : index
  %m_rounded = index.add %m_size, %c255 : index
  %m_tiles = index.div %m_rounded, %c256 : index
  %n_tiles = index.div %n_size0, %c128 : index
  kernel.launch.config workgroups(%n_tiles, %m_tiles, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%m_size: index, %a: buffer, %w: buffer, %scale: buffer, %a_scale: buffer, %c: buffer, %gate: buffer) {
  %k_size0 = index.constant 16384 : index
  %n_size0 = index.constant 6144 : index
  %k_size = index.assume %k_size0 [range(%k_size0, 128, 65536), mul(%k_size0, 128)] : index
  %n_size = index.assume %n_size0 [range(%n_size0, 128, 65536), mul(%n_size0, 128)] : index

