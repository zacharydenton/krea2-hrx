      %fbrag0 = vector.fragment<rhs> %db0 shape [%m, %k] using {schema = %i4_schema : encoding<schema>} : vector<2xi32>
      %db1 = vector.load %w_stage[%fb1, %kq] : view<128x20xi32> -> vector<2xi32>
