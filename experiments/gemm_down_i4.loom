    }
    %load_a3 = scalar.andi %in_k, %a_ok3 : i1
    %na3 = scf.if %load_a3 -> (vector<4xi32>) {
      %v = vector.load %a_view[%a_row3, %kq_next] : view<[%m_bounded]x[%k_quads]xi32> -> vector<4xi32>
