// out[c][r] = in[r][c] for r < rows, zero for rows <= r < row_capacity: the V
// operand of attention needs each channel's keys contiguous. One workgroup per
// 32x32 tile through LDS; the tile is read row-major and written column-major.
amdgpu.target<gfx11-generic> @krea2_transpose_gfx11 {subgroup_size = 32}

config.decl @krea2.transpose_f16.cols : %value: index where [range(%value, 32, 65536), mul(%value, 32)]

config.decl @krea2.transpose_f16.row_capacity : %value: index where [range(%value, 32, 1048576), mul(%value, 32)]

kernel.def target(@krea2_transpose_gfx11) export("krea2_transpose_f16") @krea2_transpose_f16(%rows: index) {
  %c1 = index.constant 1 : index
  %c32 = index.constant 32 : index
  %c256 = index.constant 256 : index
  %cols = config.get @krea2.transpose_f16.cols : index
  %row_capacity = config.get @krea2.transpose_f16.row_capacity : index
  %row_tiles = index.div %row_capacity, %c32 : index
  %col_tiles = index.div %cols, %c32 : index
  kernel.launch.config workgroups(%col_tiles, %row_tiles, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%rows: index, %in: buffer, %out: buffer) {
  %cols = config.get @krea2.transpose_f16.cols : index
  %row_capacity = config.get @krea2.transpose_f16.row_capacity : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c32 = index.constant 32 : index
  %c0_offset = index.constant 0 : offset
  %tile_bytes = index.constant 2048 : offset
  %zero = scalar.constant 0.0 : f16
  %rows_b = index.assume %rows [range(%rows, 1, 1048576)] : index
  %col_tile = kernel.workgroup.id<x> : index
  %row_tile = kernel.workgroup.id<y> : index
  %workitem = kernel.workitem.id<x> : index
  %in_global = buffer.assume.memory_space<global> %in : buffer
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %in_view = buffer.view %in_global[%c0_offset] : buffer -> view<[%rows_b]x[%cols]xf16>
  %out_view = buffer.view %out_global[%c0_offset] : buffer -> view<[%cols]x[%row_capacity]xf16>
  %tile = buffer.alloca<workgroup> align(16) %tile_bytes : buffer
  %tile_view = buffer.view %tile[%c0_offset] : buffer -> view<32x32xf16>
  %col_base = index.mul %col_tile, %c32 : index
  %row_base = index.mul %row_tile, %c32 : index
  // read: 256 lanes x 4 elements = a 32x32 tile; lane -> row workitem/8, cols (workitem%8)*4
  %r_local = index.div %workitem, %c8 : index
  %c_local0 = index.rem %workitem, %c8 : index
  %c_local = index.mul %c_local0, %c4 : index
  %r0 = index.add %row_base, %r_local : index
  %r_ok = index.cmp ult, %r0, %rows_b : index
  %c_col0 = index.add %col_base, %c_local : index
  scf.for %e = [%c0 to %c4 step %c1] {
    %cc = index.add %c_local, %e : index
    %ccg0 = index.add %c_col0, %e : index
    %v = scf.if %r_ok -> (f16) {
      %r = index.assume %r0 [lt(%r0, %rows_b)] : index
      %ccg = index.assume %ccg0 [lt(%ccg0, %cols)] : index
      %x = view.load %in_view[%r, %ccg] : view<[%rows_b]x[%cols]xf16> -> f16
      scf.yield %x : f16
    } else {
      scf.yield %zero : f16
    }
    view.store %v, %tile_view[%r_local, %cc] : f16, view<32x32xf16>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  // write transposed: lane -> out row (channel) workitem/8, out cols (keys) (workitem%8)*4
  %oc0 = index.add %col_base, %r_local : index
  %oc = index.assume %oc0 [lt(%oc0, %cols)] : index
  scf.for %e = [%c0 to %c4 step %c1] {
    %kk = index.add %c_local, %e : index
    %ok0 = index.add %row_base, %kk : index
    %ok = index.assume %ok0 [lt(%ok0, %row_capacity)] : index
    %x = view.load %tile_view[%kk, %r_local] : view<32x32xf16> -> f16
    view.store %x, %out_view[%oc, %ok] : f16, view<[%cols]x[%row_capacity]xf16>
  }
  kernel.return
}
