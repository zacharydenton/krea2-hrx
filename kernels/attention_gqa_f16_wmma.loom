    %rescaled5 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc5, %selected_old_scale : vector<8xf32>
    %rescaled6 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc6, %selected_old_scale : vector<8xf32>
    %rescaled7 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc7, %selected_old_scale : vector<8xf32>
    %next0 = vector.mma %probability, %v0, %rescaled0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %next1 = vector.mma %probability, %v1, %rescaled1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %next2 = vector.mma %probability, %v2, %rescaled2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %next3 = vector.mma %probability, %v3, %rescaled3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %next4 = vector.mma %probability, %v4, %rescaled4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %next5 = vector.mma %probability, %v5, %rescaled5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %next6 = vector.mma %probability, %v6, %rescaled6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %next7 = vector.mma %probability, %v7, %rescaled7 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next_max_even, %next_sum_even, %next_max_odd, %next_sum_odd, %next0, %next1, %next2, %next3, %next4, %next5, %next6, %next7 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }

  %selected_sum = scf.if %lane_group_even -> (vector<8xf32>) {
    scf.yield %final_sum_even : vector<8xf32>
  } else {
    scf.yield %final_sum_odd : vector<8xf32>
  }
  %out0 = vector.divf<nnan|ninf|nsz|arcp> %final0, %selected_sum : vector<8xf32>
  %out1 = vector.divf<nnan|ninf|nsz|arcp> %final1, %selected_sum : vector<8xf32>
  %out2 = vector.divf<nnan|ninf|nsz|arcp> %final2, %selected_sum : vector<8xf32>
  %out3 = vector.divf<nnan|ninf|nsz|arcp> %final3, %selected_sum : vector<8xf32>
  %out4 = vector.divf<nnan|ninf|nsz|arcp> %final4, %selected_sum : vector<8xf32>
  %out5 = vector.divf<nnan|ninf|nsz|arcp> %final5, %selected_sum : vector<8xf32>
  %out6 = vector.divf<nnan|ninf|nsz|arcp> %final6, %selected_sum : vector<8xf32>
  %out7 = vector.divf<nnan|ninf|nsz|arcp> %final7, %selected_sum : vector<8xf32>
  vector.fragment.store<result> %out0, %result_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out1, %result_view[%c0, %c16] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out2, %result_view[%c0, %c32] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out3, %result_view[%c0, %c48] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out4, %result_view[%c0, %c64] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out5, %result_view[%c0, %c80] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out6, %result_view[%c0, %c96] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out7, %result_view[%c0, %c112] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  // 16 rows x 128 channels is 512 vector4s over 32 lanes: sixteen each, with the
  // rows that ran past the sequence dropped.
  %hidden_vector_limit = index.sub %q_stride0, %c4 : index
  scf.for %step = [%c0 to %c16 step %c1] {
    %slot_base = index.mul %step, %c32 : index
    %slot = index.add %slot_base, %lane : index
    %row = index.div %slot, %c32 : index
    %column_group = index.rem %slot, %c32 : index
    %column = index.mul %column_group, %c4 : index
    %local_row = index.add %local_query_origin, %row : index
    %present = index.cmp ult, %local_row, %tokens_per_image0 : index
    %global_row0 = index.add %image_base, %local_row : index
    %in_range = index.cmp ult, %global_row0, %token_count : index
    %writes = scalar.andi %present, %in_range : i1
    scf.if %writes {
      %global_row = index.assume %global_row0 [lt(%global_row0, %token_count)] : index
      %values = vector.load %result_view[%row, %column] : view<16x128xf32> -> vector<4xf32>
      %halves = vector.fptrunc %values : vector<4xf32> to vector<4xf16>
      %out_column0 = index.add %head_base0, %column : index
      %out_column = index.assume %out_column0 [le(%out_column0, %hidden_vector_limit)] : index
      vector.store %halves, %out_view[%global_row, %out_column] : vector<4xf16>, view<[%token_count]x[%q_stride0]xf16>
    }
  }
  kernel.return
}
