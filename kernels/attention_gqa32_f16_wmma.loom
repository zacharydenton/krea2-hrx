  %head = index.rem %head_raw, %head_limit : index
  %kv_head_limit = index.div %kv_stride0, %c128 : index
  %kv_head0 = index.div %head, %kv_groups : index
  %kv_head = index.rem %kv_head0, %kv_head_limit : index
