  %tiles_per_image = index.div %rounded, %c16 : index
  %tile_in_image = index.rem %tile_id, %tiles_per_image : index
  %image_base = index.add %c0, %c0 : index
  %local_query_origin = index.mul %tile_in_image, %c16 : index
  %query_origin0 = index.add %image_base, %local_query_origin : index
  %head_base0 = index.mul %head, %c128 : index
  %kv_base0 = index.mul %kv_head, %c128 : index

  // Every tile origin is below token_count, and the caller keeps token_count at
