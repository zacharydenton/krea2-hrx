// Online-softmax attention for Krea 2: one wave32 per (16 query rows, head), head
// dim 128, grouped-query heads (kv head = head / kv_groups), a single sequence.
//
// Ported from dinov3-loom's attention_online_f16_wmma (itself from hrx-demos'
// ideogram4 kernel): K and V fragments load straight from global, K's transpose
// is a strided view, the workgroup is one wave, and the only LDS is 512 bytes to
// turn the f32 score fragment into an f16 lhs for P*V plus the 8 KB result stage.
// Running max and sum stay in registers, split across the two lane groups that own
// different fragment rows; eight 16x16 accumulators hold the 128 output channels.
//
// q is f16 [tokens][q_stride] (the 48 heads x 128); k and v are f16
// [tokens][kv_stride] (the 12 kv heads x 128). Their buffers need 16 rows of
// headroom (token_capacity >= tokens + 16): the overhanging rows are masked.
// Output is f16 [tokens][q_stride] at this head's 128 channels.
//
// 32 keys per iteration: 2 score fragments per query tile share the eight query
// fragments, one cross-lane max and one sum per 64 keys, one barrier pair per 64 keys.
//
// GENERATED by tools/gen_attention64.py from the 16-key kernel; edit the generator.
amdgpu.target<gfx11-generic> @krea2_attention_gqa32_gfx11 {subgroup_size = 32}

config.decl @krea2.attention_gqa32_f16_wmma.kv_stride : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

config.decl @krea2.attention_gqa32_f16_wmma.kv_groups : %value: index where [range(%value, 1, 64)]

config.decl @krea2.attention_gqa32_f16_wmma.out_stride : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

config.decl @krea2.attention_gqa32_f16_wmma.q_stride : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

config.decl @krea2.attention_gqa32_f16_wmma.tokens : %value: index where [range(%value, 16, 65536)]

config.decl @krea2.attention_gqa32_f16_wmma.scale : f32

// View extent for q/k/v. Only used for bounds proofs -- every access is guarded
// against the real token count -- but it must be a compile-time constant or the
// fragment load reports a dynamic stride and will not lower.
config.decl @krea2.attention_gqa32_f16_wmma.token_capacity : %value: index where [range(%value, 16, 1048576), mul(%value, 16)]

kernel.def target(@krea2_attention_gqa32_gfx11) export("krea2_attention_gqa32_f16_wmma") @krea2_attention_gqa32_f16_wmma(%token_count: index, %head_count: index) {
  %c1 = index.constant 1 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %tokens_per_image0 = config.get @krea2.attention_gqa32_f16_wmma.tokens : index
  %rounded = index.add %tokens_per_image0, %c15 : index
  %tiles_per_image = index.div %rounded, %c16 : index
  kernel.launch.config workgroups(%tiles_per_image, %head_count, %c1) workgroup_size(%c32, %c1, %c1) : index
} launch(%token_count: index, %q: buffer, %k: buffer, %v: buffer, %out: buffer) {
  %q_stride0 = config.get @krea2.attention_gqa32_f16_wmma.q_stride : index
  %kv_stride0 = config.get @krea2.attention_gqa32_f16_wmma.kv_stride : index
  %kv_groups = config.get @krea2.attention_gqa32_f16_wmma.kv_groups : index
  %out_stride0 = config.get @krea2.attention_gqa32_f16_wmma.out_stride : index
  %tokens_per_image0 = config.get @krea2.attention_gqa32_f16_wmma.tokens : index
  %scale = config.get @krea2.attention_gqa32_f16_wmma.scale : f32

  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c15 = index.constant 15 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c48 = index.constant 48 : index
  %c64 = index.constant 64 : index
  %c80 = index.constant 80 : index
  %c96 = index.constant 96 : index
  %c112 = index.constant 112 : index
  %c128 = index.constant 128 : index
  %c0_offset = index.constant 0 : offset
  %scratch_bytes = index.constant 1024 : offset
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k_frag = index.constant 16 : index
  %zero_f32 = scalar.constant 0.0 : f32
  %negative_large = scalar.constant -1000000000.0 : f32
  %zero_acc = vector.constant 0.0 : vector<8xf32>
