    %key_row0_0 = index.add %ko0, %lane_column : index
    %key_row0 = index.assume %key_row0_0 [lt(%key_row0_0, %padded_tokens)] : index
    %key_valid0 = index.cmp ult, %key_row0_0, %tokens_per_image0 : index
    %ko1_0 = index.add %key_block_origin, %c16 : index
