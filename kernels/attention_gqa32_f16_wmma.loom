    %tile_sum_even = kernel.workgroup.reduce<addf> %even_weight : vector<8xf32>
    %tile_sum_odd = kernel.workgroup.reduce<addf> %odd_weight : vector<8xf32>
    %old_delta_even = vector.subf<reassoc|nnan|ninf|nsz> %max_even, %next_max_even : vector<8xf32>
    %old_delta_odd = vector.subf<reassoc|nnan|ninf|nsz> %max_odd, %next_max_odd : vector<8xf32>
    %old_scale_even = vector.expf<afn> %old_delta_even : vector<8xf32>
    %old_scale_odd = vector.expf<afn> %old_delta_odd : vector<8xf32>
    %scaled_sum_even = vector.mulf<reassoc|nnan|ninf|nsz|contract> %sum_even, %old_scale_even : vector<8xf32>
    %scaled_sum_odd = vector.mulf<reassoc|nnan|ninf|nsz|contract> %sum_odd, %old_scale_odd : vector<8xf32>
    %next_sum_even = vector.addf<reassoc|nnan|ninf|nsz> %scaled_sum_even, %tile_sum_even : vector<8xf32>
    %next_sum_odd = vector.addf<reassoc|nnan|ninf|nsz> %scaled_sum_odd, %tile_sum_odd : vector<8xf32>
    %selected_old_scale = scf.if %lane_group_even -> (vector<8xf32>) {
      scf.yield %old_scale_even : vector<8xf32>
    } else {
      scf.yield %old_scale_odd : vector<8xf32>
    }
    vector.fragment.store<result> %weight0, %scratch_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<32x16xf16>
    vector.fragment.store<result> %weight1, %scratch_view[%c16, %c0] shape [%m, %n] : vector<8xf32>, view<32x16xf16>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    %probability0 = vector.fragment.load<lhs> %scratch_view[%c0, %c0] shape [%m, %k_frag] : view<32x16xf16> -> vector<16xf16>
    %probability1 = vector.fragment.load<lhs> %scratch_view[%c16, %c0] shape [%m, %k_frag] : view<32x16xf16> -> vector<16xf16>
    %vt_row0 = index.add %kv_base0, %lane_column : index
    %rescaled0 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc0, %selected_old_scale : vector<8xf32>
    %vt_row1 = index.add %kv_channel1, %lane_column : index
    %rescaled1 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc1, %selected_old_scale : vector<8xf32>
    %vt_row2 = index.add %kv_channel2, %lane_column : index
    %rescaled2 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc2, %selected_old_scale : vector<8xf32>
    %vt_row3 = index.add %kv_channel3, %lane_column : index
    %rescaled3 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc3, %selected_old_scale : vector<8xf32>
    %vt_row4 = index.add %kv_channel4, %lane_column : index
    %rescaled4 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc4, %selected_old_scale : vector<8xf32>
    %vt_row5 = index.add %kv_channel5, %lane_column : index
    %rescaled5 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc5, %selected_old_scale : vector<8xf32>
    %vt_row6 = index.add %kv_channel6, %lane_column : index
    %rescaled6 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc6, %selected_old_scale : vector<8xf32>
    %vt_row7 = index.add %kv_channel7, %lane_column : index
    %rescaled7 = vector.mulf<reassoc|nnan|ninf|nsz|contract> %acc7, %selected_old_scale : vector<8xf32>
    %v_data0_0 = vector.load %vt_view[%vt_row0, %ko0] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v0_0 = vector.fragment<rhs> %v_data0_0 shape [%k_frag, %n] : vector<16xf16>
    %pv0_0 = vector.mma %probability0, %v0_0, %rescaled0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data1_0 = vector.load %vt_view[%vt_row0, %ko1] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v1_0 = vector.fragment<rhs> %v_data1_0 shape [%k_frag, %n] : vector<16xf16>
    %next0 = vector.mma %probability1, %v1_0, %pv0_0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data0_1 = vector.load %vt_view[%vt_row1, %ko0] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v0_1 = vector.fragment<rhs> %v_data0_1 shape [%k_frag, %n] : vector<16xf16>
    %pv0_1 = vector.mma %probability0, %v0_1, %rescaled1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data1_1 = vector.load %vt_view[%vt_row1, %ko1] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v1_1 = vector.fragment<rhs> %v_data1_1 shape [%k_frag, %n] : vector<16xf16>
    %next1 = vector.mma %probability1, %v1_1, %pv0_1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data0_2 = vector.load %vt_view[%vt_row2, %ko0] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v0_2 = vector.fragment<rhs> %v_data0_2 shape [%k_frag, %n] : vector<16xf16>
    %pv0_2 = vector.mma %probability0, %v0_2, %rescaled2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data1_2 = vector.load %vt_view[%vt_row2, %ko1] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v1_2 = vector.fragment<rhs> %v_data1_2 shape [%k_frag, %n] : vector<16xf16>
    %next2 = vector.mma %probability1, %v1_2, %pv0_2 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data0_3 = vector.load %vt_view[%vt_row3, %ko0] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v0_3 = vector.fragment<rhs> %v_data0_3 shape [%k_frag, %n] : vector<16xf16>
    %pv0_3 = vector.mma %probability0, %v0_3, %rescaled3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data1_3 = vector.load %vt_view[%vt_row3, %ko1] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v1_3 = vector.fragment<rhs> %v_data1_3 shape [%k_frag, %n] : vector<16xf16>
    %next3 = vector.mma %probability1, %v1_3, %pv0_3 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data0_4 = vector.load %vt_view[%vt_row4, %ko0] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v0_4 = vector.fragment<rhs> %v_data0_4 shape [%k_frag, %n] : vector<16xf16>
    %pv0_4 = vector.mma %probability0, %v0_4, %rescaled4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data1_4 = vector.load %vt_view[%vt_row4, %ko1] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v1_4 = vector.fragment<rhs> %v_data1_4 shape [%k_frag, %n] : vector<16xf16>
    %next4 = vector.mma %probability1, %v1_4, %pv0_4 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data0_5 = vector.load %vt_view[%vt_row5, %ko0] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v0_5 = vector.fragment<rhs> %v_data0_5 shape [%k_frag, %n] : vector<16xf16>
    %pv0_5 = vector.mma %probability0, %v0_5, %rescaled5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data1_5 = vector.load %vt_view[%vt_row5, %ko1] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v1_5 = vector.fragment<rhs> %v_data1_5 shape [%k_frag, %n] : vector<16xf16>
    %next5 = vector.mma %probability1, %v1_5, %pv0_5 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data0_6 = vector.load %vt_view[%vt_row6, %ko0] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v0_6 = vector.fragment<rhs> %v_data0_6 shape [%k_frag, %n] : vector<16xf16>
    %pv0_6 = vector.mma %probability0, %v0_6, %rescaled6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data1_6 = vector.load %vt_view[%vt_row6, %ko1] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v1_6 = vector.fragment<rhs> %v_data1_6 shape [%k_frag, %n] : vector<16xf16>
    %next6 = vector.mma %probability1, %v1_6, %pv0_6 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data0_7 = vector.load %vt_view[%vt_row7, %ko0] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v0_7 = vector.fragment<rhs> %v_data0_7 shape [%k_frag, %n] : vector<16xf16>
    %pv0_7 = vector.mma %probability0, %v0_7, %rescaled7 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    %v_data1_7 = vector.load %vt_view[%vt_row7, %ko1] : view<[%kv_stride0]x[%padded_tokens]xf16> -> vector<16xf16>
    %v1_7 = vector.fragment<rhs> %v_data1_7 shape [%k_frag, %n] : vector<16xf16>
    %next7 = vector.mma %probability1, %v1_7, %pv0_7 : vector<16xf16>, vector<16xf16>, vector<8xf32>
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next_max_even, %next_sum_even, %next_max_odd, %next_sum_odd, %next0, %next1, %next2, %next3, %next4, %next5, %next6, %next7 : vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>, vector<8xf32>
  }
  %selected_sum = scf.if %lane_group_even -> (vector<8xf32>) {
    scf.yield %final_sum_even : vector<8xf32>
  } else {
    scf.yield %final_sum_odd : vector<8xf32>
  }
  %out0 = vector.divf<nnan|ninf|nsz|arcp> %final0, %selected_sum : vector<8xf32>
  %out1 = vector.divf<nnan|ninf|nsz|arcp> %final1, %selected_sum : vector<8xf32>
  %out2 = vector.divf<nnan|ninf|nsz|arcp> %final2, %selected_sum : vector<8xf32>
  %out3 = vector.divf<nnan|ninf|nsz|arcp> %final3, %selected_sum : vector<8xf32>
  %out4 = vector.divf<nnan|ninf|nsz|arcp> %final4, %selected_sum : vector<8xf32>
  %out5 = vector.divf<nnan|ninf|nsz|arcp> %final5, %selected_sum : vector<8xf32>
  %out6 = vector.divf<nnan|ninf|nsz|arcp> %final6, %selected_sum : vector<8xf32>
  %out7 = vector.divf<nnan|ninf|nsz|arcp> %final7, %selected_sum : vector<8xf32>
  vector.fragment.store<result> %out0, %result_view[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out1, %result_view[%c0, %c16] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out2, %result_view[%c0, %c32] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out3, %result_view[%c0, %c48] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out4, %result_view[%c0, %c64] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out5, %result_view[%c0, %c80] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out6, %result_view[%c0, %c96] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  vector.fragment.store<result> %out7, %result_view[%c0, %c112] shape [%m, %n] : vector<8xf32>, view<16x128xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  // 16 rows x 128 channels is 512 vector4s over 32 lanes: sixteen each, with the
  // rows that ran past the sequence dropped.
  %hidden_vector_limit = index.sub %q_stride0, %c4 : index
  scf.for %step = [%c0 to %c16 step %c1] {
    %slot_base = index.mul %step, %c32 : index
    %slot = index.add %slot_base, %lane : index
    %row = index.div %slot, %c32 : index
    %column_group = index.rem %slot, %c32 : index
    %column = index.mul %column_group, %c4 : index
    %local_row = index.add %local_query_origin, %row : index
    %present = index.cmp ult, %local_row, %tokens_per_image0 : index
    %global_row0 = index.add %image_base, %local_row : index
    %in_range = index.cmp ult, %global_row0, %token_count : index
    %writes = scalar.andi %present, %in_range : i1
    scf.if %writes {
      %global_row = index.assume %global_row0 [lt(%global_row0, %token_count)] : index
      %values = vector.load %result_view[%row, %column] : view<16x128xf32> -> vector<4xf32>
      %halves = vector.fptrunc %values : vector<4xf32> to vector<4xf16>
      %out_column0 = index.add %head_base0, %column : index
      %out_column = index.assume %out_column0 [le(%out_column0, %hidden_vector_limit)] : index
      vector.store %halves, %out_view[%global_row, %out_column] : vector<4xf16>, view<[%token_count]x[%out_stride0]xf16>
    }
  }
  kernel.return
}
