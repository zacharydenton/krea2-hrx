amdgpu.target<gfx11-generic> @krea2_guidance_target {subgroup_size = 32}

config.decl @krea2.guidance.grid_x : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.guidance.grid_y : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@krea2_guidance_target) export("krea2_guidance") @krea2_guidance(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %grid_x = config.get @krea2.guidance.grid_x : index
  %grid_y = config.get @krea2.guidance.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %scale: f32, %cond: buffer, %uncond: buffer) {
  %v1 = index.constant 256 : index
  %zero_offset = index.constant 0 : offset
  %count_b = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %v2 = index.mul %group, %v1 : index
  %v3 = index.add %v2, %lane : index
  %cond_global = buffer.assume.memory_space<global> %cond : buffer
  %cond_view = buffer.view %cond_global[%zero_offset] : buffer -> view<[%count_b]xbf16>
  %uncond_global = buffer.assume.memory_space<global> %uncond : buffer
  %uncond_view = buffer.view %uncond_global[%zero_offset] : buffer -> view<[%count_b]xbf16>
  %v4 = index.cmp ult, %v3, %count_b : index
  scf.if %v4 {
    %v5 = index.assume %v3 [range(%v3, 0, 1073741824), lt(%v3, %count_b)] : index
    %v6 = view.load %cond_view[%v5] : view<[%count_b]xbf16> -> bf16
    %v7 = scalar.extf %v6 : bf16 to f32
    %v8 = index.assume %v3 [range(%v3, 0, 1073741824), lt(%v3, %count_b)] : index
    %v9 = view.load %uncond_view[%v8] : view<[%count_b]xbf16> -> bf16
    %v10 = scalar.extf %v9 : bf16 to f32
    %v11 = scalar.subf %v7, %v10 : f32
    %v12 = scalar.fptrunc %v11 : f32 to bf16
    %v13 = scalar.extf %v12 : bf16 to f32
    %v14 = scalar.mulf %scale, %v13 : f32
    %v15 = scalar.fptrunc %v14 : f32 to bf16
    %v16 = scalar.extf %v15 : bf16 to f32
    %v17 = scalar.addf %v7, %v16 : f32
    %v18 = scalar.fptrunc %v17 : f32 to bf16
    %v19 = index.assume %v3 [range(%v3, 0, 1073741824), lt(%v3, %count_b)] : index
    view.store %v18, %cond_view[%v19] : bf16, view<[%count_b]xbf16>
  }
  kernel.return
}
