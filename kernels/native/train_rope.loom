amdgpu.target<gfx11-generic> @krea2_train_rope_target {subgroup_size = 32}

config.decl @krea2.train_rope.grid_x : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_rope.grid_y : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.train_rope.cols : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_rope.tables : %value: index where [range(%value, 1, 1073741824)]
kernel.def target(@krea2_train_rope_target) export("krea2_train_rope") @krea2_train_rope(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %grid_x = config.get @krea2.train_rope.grid_x : index
  %grid_y = config.get @krea2.train_rope.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %direction: f32, %x: buffer, %cos: buffer, %sin: buffer, %out: buffer) {
  %zero_offset = index.constant 0 : offset
  %n = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %step = index.constant 256 : index
  %two = index.constant 2 : index
  %one = index.constant 1 : index
  %head = index.constant 128 : index
  %base = index.mul %group, %step : index
  %idx = index.add %base, %lane : index
  %cols = config.get @krea2.train_rope.cols : index
  %tables = config.get @krea2.train_rope.tables : index
  %xg = buffer.assume.memory_space<global> %x : buffer
  %xv = buffer.view %xg[%zero_offset] : buffer -> view<[%n]xbf16>
  %cg = buffer.assume.memory_space<global> %cos : buffer
  %cv = buffer.view %cg[%zero_offset] : buffer -> view<[%tables]xf32>
  %sg = buffer.assume.memory_space<global> %sin : buffer
  %sv = buffer.view %sg[%zero_offset] : buffer -> view<[%tables]xf32>
  %og = buffer.assume.memory_space<global> %out : buffer
  %ov = buffer.view %og[%zero_offset] : buffer -> view<[%n]xbf16>
  %ok = index.cmp ult, %idx, %n : index
  scf.if %ok {
    %i = index.assume %idx [range(%idx, 0, 1073741824), lt(%idx, %n)] : index
    %pair = index.div %i, %two : index
    %even = index.mul %pair, %two : index
    %parity = index.rem %i, %two : index
    %other = index.sub %one, %parity : index
    %partner = index.add %even, %other : index
    %pi = index.assume %partner [range(%partner, 0, 1073741824), lt(%partner, %n)] : index
    %row = index.div %i, %cols : index
    %channel = index.rem %i, %head : index
    %rowbase = index.mul %row, %head : index
    %ti0 = index.add %rowbase, %channel : index
    %ti = index.assume %ti0 [range(%ti0, 0, 1073741824), lt(%ti0, %tables)] : index
    %xb = view.load %xv[%i] : view<[%n]xbf16> -> bf16
    %yb = view.load %xv[%pi] : view<[%n]xbf16> -> bf16
    %xf = scalar.extf %xb : bf16 to f32
    %yf = scalar.extf %yb : bf16 to f32
    %c = view.load %cv[%ti] : view<[%tables]xf32> -> f32
    %s = view.load %sv[%ti] : view<[%tables]xf32> -> f32
    %signi = index.cast %parity : index to i32
    %signf = scalar.sitofp %signi : i32 to f32
    %twof = scalar.constant 2.0 : f32
    %onef = scalar.constant 1.0 : f32
    %twop = scalar.mulf %signf, %twof : f32
    %sign = scalar.subf %twop, %onef : f32
    %signed = scalar.mulf %sign, %direction : f32
    %ys = scalar.mulf %yf, %s : f32
    %rotated = scalar.mulf %ys, %signed : f32
    %xc = scalar.mulf %xf, %c : f32
    %result = scalar.addf %xc, %rotated : f32
    %rounded = scalar.fptrunc %result : f32 to bf16
    view.store %rounded, %ov[%i] : bf16, view<[%n]xbf16>
  }
  kernel.return
}
