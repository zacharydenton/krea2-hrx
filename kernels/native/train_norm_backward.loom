amdgpu.target<gfx11-generic> @krea2_train_norm_backward_target {subgroup_size = 32}

config.decl @krea2.train_norm_backward.cols : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_norm_backward.size : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_norm_backward.grid_x : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_norm_backward.grid_y : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@krea2_train_norm_backward_target) export("krea2_train_norm_backward") @krea2_train_norm_backward(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  %grid_x = config.get @krea2.train_norm_backward.grid_x : index
  %grid_y = config.get @krea2.train_norm_backward.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %eps: f32, %x: buffer, %grad: buffer, %w: buffer, %out: buffer) {
  %zero_offset = index.constant 0 : offset
  %n = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %step = index.constant 32 : index
  %base = index.mul %group, %step : index
  %idx = index.add %base, %lane : index
  %cols = config.get @krea2.train_norm_backward.cols : index
  %size = config.get @krea2.train_norm_backward.size : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %xv = buffer.view %x_global[%zero_offset] : buffer -> view<[%size]xbf16>
  %grad_global = buffer.assume.memory_space<global> %grad : buffer
  %gradv = buffer.view %grad_global[%zero_offset] : buffer -> view<[%size]xbf16>
  %w_global = buffer.assume.memory_space<global> %w : buffer
  %wv = buffer.view %w_global[%zero_offset] : buffer -> view<[%cols]xf32>
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %outv = buffer.view %out_global[%zero_offset] : buffer -> view<[%size]xbf16>
  %zero = scalar.constant 0.0 : f32
  %onef = scalar.constant 1.0 : f32
  %width = index.cast %cols : index to i32
  %widthf = scalar.sitofp %width : i32 to f32
  %rowbase = index.mul %group, %cols : index
  %ss, %gg = scf.for %c = [%lane to %cols step %step](%ss0 = %zero, %gg0 = %zero : f32, f32) -> (f32, f32) {
    %at = index.add %rowbase, %c : index
    %i = index.assume %at [range(%at, 0, 1073741824), lt(%at, %size)] : index
    %xfbits = view.load %xv[%i] : view<[%size]xbf16> -> bf16
    %xf = scalar.extf %xfbits : bf16 to f32
    %gfbits = view.load %gradv[%i] : view<[%size]xbf16> -> bf16
    %gf = scalar.extf %gfbits : bf16 to f32
    %wi = index.assume %c [range(%c, 0, 1073741824), lt(%c, %cols)] : index
    %weight = view.load %wv[%wi] : view<[%cols]xf32> -> f32
    %scale = scalar.addf %onef, %weight : f32
    %dx = scalar.mulf %gf, %scale : f32
    %square = scalar.mulf %xf, %xf : f32
    %dot = scalar.mulf %xf, %dx : f32
    %sn = scalar.addf %ss0, %square : f32
    %gn = scalar.addf %gg0, %dot : f32
    scf.yield %sn, %gn : f32, f32
  }
  %warp = scalar.constant 32 : i32
  %ssoff16 = scalar.constant 16 : i32
  %sspeer16, %ssvalid16 = kernel.subgroup.shuffle<xor> %ss, %ssoff16, %warp : f32, i32, i32
  %sssum16 = scalar.addf %ss, %sspeer16 : f32
  %ssoff8 = scalar.constant 8 : i32
  %sspeer8, %ssvalid8 = kernel.subgroup.shuffle<xor> %sssum16, %ssoff8, %warp : f32, i32, i32
  %sssum8 = scalar.addf %sssum16, %sspeer8 : f32
  %ssoff4 = scalar.constant 4 : i32
  %sspeer4, %ssvalid4 = kernel.subgroup.shuffle<xor> %sssum8, %ssoff4, %warp : f32, i32, i32
  %sssum4 = scalar.addf %sssum8, %sspeer4 : f32
  %ssoff2 = scalar.constant 2 : i32
  %sspeer2, %ssvalid2 = kernel.subgroup.shuffle<xor> %sssum4, %ssoff2, %warp : f32, i32, i32
  %sssum2 = scalar.addf %sssum4, %sspeer2 : f32
  %ssoff1 = scalar.constant 1 : i32
  %sspeer1, %ssvalid1 = kernel.subgroup.shuffle<xor> %sssum2, %ssoff1, %warp : f32, i32, i32
  %sssum1 = scalar.addf %sssum2, %sspeer1 : f32
  %ggoff16 = scalar.constant 16 : i32
  %ggpeer16, %ggvalid16 = kernel.subgroup.shuffle<xor> %gg, %ggoff16, %warp : f32, i32, i32
  %ggsum16 = scalar.addf %gg, %ggpeer16 : f32
  %ggoff8 = scalar.constant 8 : i32
  %ggpeer8, %ggvalid8 = kernel.subgroup.shuffle<xor> %ggsum16, %ggoff8, %warp : f32, i32, i32
  %ggsum8 = scalar.addf %ggsum16, %ggpeer8 : f32
  %ggoff4 = scalar.constant 4 : i32
  %ggpeer4, %ggvalid4 = kernel.subgroup.shuffle<xor> %ggsum8, %ggoff4, %warp : f32, i32, i32
  %ggsum4 = scalar.addf %ggsum8, %ggpeer4 : f32
  %ggoff2 = scalar.constant 2 : i32
  %ggpeer2, %ggvalid2 = kernel.subgroup.shuffle<xor> %ggsum4, %ggoff2, %warp : f32, i32, i32
  %ggsum2 = scalar.addf %ggsum4, %ggpeer2 : f32
  %ggoff1 = scalar.constant 1 : i32
  %ggpeer1, %ggvalid1 = kernel.subgroup.shuffle<xor> %ggsum2, %ggoff1, %warp : f32, i32, i32
  %ggsum1 = scalar.addf %ggsum2, %ggpeer1 : f32
  %mean = scalar.divf %sssum1, %widthf : f32
  %variance = scalar.addf %mean, %eps : f32
  %root = scalar.sqrtf %variance : f32
  %inv = scalar.divf %onef, %root : f32
  %dotmean = scalar.divf %ggsum1, %widthf : f32
  %correction = scalar.divf %dotmean, %variance : f32
  scf.for %c2 = [%lane to %cols step %step] {
    %at2 = index.add %rowbase, %c2 : index
    %i2 = index.assume %at2 [range(%at2, 0, 1073741824), lt(%at2, %size)] : index
    %xf2bits = view.load %xv[%i2] : view<[%size]xbf16> -> bf16
    %xf2 = scalar.extf %xf2bits : bf16 to f32
    %gf2bits = view.load %gradv[%i2] : view<[%size]xbf16> -> bf16
    %gf2 = scalar.extf %gf2bits : bf16 to f32
    %wi2 = index.assume %c2 [range(%c2, 0, 1073741824), lt(%c2, %cols)] : index
    %weight2 = view.load %wv[%wi2] : view<[%cols]xf32> -> f32
    %scale2 = scalar.addf %onef, %weight2 : f32
    %dx2 = scalar.mulf %gf2, %scale2 : f32
    %corr2 = scalar.mulf %xf2, %correction : f32
    %centered = scalar.subf %dx2, %corr2 : f32
    %result = scalar.mulf %centered, %inv : f32
    %rounded = scalar.fptrunc %result : f32 to bf16
    view.store %rounded, %outv[%i2] : bf16, view<[%size]xbf16>
  }
  kernel.return
}
