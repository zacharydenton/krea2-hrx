// Dense training GEMM: 128x64 output tile, 64-wide K staging, BF16 operands and FP32 accumulation.
// Keep the right operand row-major in LDS and load RHS fragments directly.
// Coalesced vector stores avoid the per-element shared-memory transpose.
// Eight waves each own a 32x32 tile. Only M may be ragged; N and K are multiples of 64.
amdgpu.target<gfx11-generic> @target {subgroup_size = 32}
config.decl @krea2.train_gemm_nn.m : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_gemm_nn.n : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_gemm_nn.k : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_gemm_nn.asize : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_gemm_nn.bsize : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_gemm_nn.csize : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_gemm_nn.astride : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_gemm_nn.bstride : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_gemm_nn.grid_x : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_gemm_nn.grid_y : %value: index where [range(%value, 1, 1073741824)]
