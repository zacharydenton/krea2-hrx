// Read each BF16 value once; write padded row-major and transposed layouts.
// Aligned columns/capacities use four-value transfers; arbitrary shapes retain scalar guards.
// Every tail element is zeroed in this pass, without a fill or copy dispatch.
amdgpu.target<gfx11-generic> @krea2_train_attention_pack_target {subgroup_size = 32}
config.decl @krea2.train_attention_pack.rows : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_attention_pack.cols : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_attention_pack.capacity : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_attention_pack.grid_x : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_attention_pack.grid_y : %value: index where [range(%value, 1, 1073741824)]
kernel.def target(@krea2_train_attention_pack_target) export("krea2_train_attention_pack") @krea2_train_attention_pack(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %gx = config.get @krea2.train_attention_pack.grid_x : index
  %gy = config.get @krea2.train_attention_pack.grid_y : index
  kernel.launch.config workgroups(%gx, %gy, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %x: buffer, %out: buffer, %transposed: buffer) {
  %full_cols = config.get @krea2.train_attention_pack.cols : index
  %full_cap = config.get @krea2.train_attention_pack.capacity : index
  %z = index.constant 0 : index
  %step = index.constant 32 : index
  %four = index.constant 4 : index
  %col_tail = index.rem %full_cols, %step : index
  %cap_tail = index.rem %full_cap, %four : index
  %col_ok = index.cmp eq, %col_tail, %z : index
  %cap_ok = index.cmp eq, %cap_tail, %z : index
  %vectorized = scalar.andi %col_ok, %cap_ok : i1
  scf.if %vectorized {
    %rows = config.get @krea2.train_attention_pack.rows : index

    %width = config.get @krea2.train_attention_pack.cols : index
    %cap = config.get @krea2.train_attention_pack.capacity : index
    %c0 = index.constant 0 : index
    %c1 = index.constant 1 : index
    %c2 = index.constant 2 : index
    %c3 = index.constant 3 : index
    %c4 = index.constant 4 : index
    %c8 = index.constant 8 : index
    %c28 = index.constant 28 : index
    %c32 = index.constant 32 : index
    %c0_offset = index.constant 0 : offset
    %lds_bytes = index.constant 2304 : offset
    %zero_h = scalar.constant 0.0 : bf16
    %zero4 = vector.splat %zero_h : vector<4xbf16>
    %rows_b = index.assume %rows [range(%rows, 1, 1073741824), le(%rows, %cap)] : index
    %group = kernel.workgroup.id<x> : index
    %column_tiles = index.div %width, %c32 : index
    %rt = index.div %group, %column_tiles : index
    %ct = index.rem %group, %column_tiles : index
    %lane = kernel.workitem.id<x> : index
    %row0 = index.mul %rt, %c32 : index
    %col0a = index.mul %ct, %c32 : index
    %col_limit = index.sub %width, %c32 : index
    %col0 = index.assume %col0a [le(%col0a, %col_limit), mul(%col0a, 32)] : index
    %x_global = buffer.assume.memory_space<global> %x : buffer
    %o_global = buffer.assume.memory_space<global> %transposed : buffer
    %x_view = buffer.view %x_global[%c0_offset] : buffer -> view<[%rows_b]x[%width]xbf16>
    %o_view = buffer.view %o_global[%c0_offset] : buffer -> view<[%width]x[%cap]xbf16>
    %p_global = buffer.assume.memory_space<global> %out : buffer
    %p_size = index.mul %cap, %width : index
    %p_limit = index.sub %p_size, %c4 : index
    %p_view = buffer.view %p_global[%c0_offset] : buffer -> view<[%p_size]xbf16>
    %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
    %tile = buffer.view %lds[%c0_offset] : buffer -> view<32x36xbf16>
    // load: lane -> row lane/8, columns (lane%8)*4 .. +4 of the tile
    %lr = index.div %lane, %c8 : index
    %lc0 = index.rem %lane, %c8 : index
    %lc = index.mul %lc0, %c4 : index
    %lcb = index.assume %lc [le(%lc, %c28), mul(%lc, 4)] : index
    %grow = index.add %row0, %lr : index
    %in_rows = index.cmp ult, %grow, %rows_b : index
    scf.if %in_rows {
      %grow_b = index.assume %grow [lt(%grow, %rows_b)] : index
      %gcol = index.add %col0, %lcb : index
      %gcol_limit = index.sub %width, %c4 : index
      %gcolb = index.assume %gcol [le(%gcol, %gcol_limit), mul(%gcol, 4)] : index
      %v = vector.load %x_view[%grow_b, %gcolb] : view<[%rows_b]x[%width]xbf16> -> vector<4xbf16>
      %p_row = index.mul %grow_b, %width : index
      %p_index0 = index.add %p_row, %gcolb : index
      %p_index = index.assume %p_index0 [le(%p_index0, %p_limit), mul(%p_index0, 4)] : index
      vector.store %v, %p_view[%p_index] : vector<4xbf16>, view<[%p_size]xbf16>
      vector.store %v, %tile[%lr, %lcb] : vector<4xbf16>, view<32x36xbf16>
    } else {
      %pad_ok = index.cmp ult, %grow, %cap : index
      scf.if %pad_ok {
        %pad_row = index.assume %grow [lt(%grow, %cap)] : index
        %pad_col0 = index.add %col0, %lcb : index
        %pad_limit = index.sub %width, %c4 : index
        %pad_col = index.assume %pad_col0 [le(%pad_col0, %pad_limit), mul(%pad_col0, 4)] : index
        %pad_base = index.mul %pad_row, %width : index
        %pad_index0 = index.add %pad_base, %pad_col : index
        %pad_index = index.assume %pad_index0 [le(%pad_index0, %p_limit), mul(%pad_index0, 4)] : index
        vector.store %zero4, %p_view[%pad_index] : vector<4xbf16>, view<[%p_size]xbf16>
      }
      vector.store %zero4, %tile[%lr, %lcb] : vector<4xbf16>, view<32x36xbf16>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    // store: lane -> tile column lane/8 (an output row), tile rows (lane%8)*4 .. +4 (output columns)
    %tc = index.div %lane, %c8 : index
    %tr = index.mul %lc0, %c4 : index
    %trb = index.assume %tr [le(%tr, %c28), mul(%tr, 4)] : index
    %e0 = view.load %tile[%trb, %tc] : view<32x36xbf16> -> bf16
    %tr1 = index.add %trb, %c1 : index
    %tr2 = index.add %trb, %c2 : index
    %tr3 = index.add %trb, %c3 : index
    %e1 = view.load %tile[%tr1, %tc] : view<32x36xbf16> -> bf16
    %e2 = view.load %tile[%tr2, %tc] : view<32x36xbf16> -> bf16
    %e3 = view.load %tile[%tr3, %tc] : view<32x36xbf16> -> bf16
    %ov = vector.from_elements %e0, %e1, %e2, %e3 : vector<4xbf16>
    %orow = index.add %col0, %tc : index
    %orow_b = index.assume %orow [lt(%orow, %width)] : index
    %ocol = index.add %row0, %trb : index
    %ocol_limit = index.sub %cap, %c4 : index
    %in_cols = index.cmp ule, %ocol, %ocol_limit : index
    scf.if %in_cols {
      %ocol_b = index.assume %ocol [le(%ocol, %ocol_limit), mul(%ocol, 4)] : index
      vector.store %ov, %o_view[%orow_b, %ocol_b] : vector<4xbf16>, view<[%width]x[%cap]xbf16>
    }
  } else {

    %offset = index.constant 0 : offset
    %n = index.assume %count [range(%count, 1, 1073741824)] : index
    %lane = kernel.workitem.id<x> : index
    %group = kernel.workgroup.id<x> : index
    %zero = index.constant 0 : index
    %zf = scalar.constant 0.0 : f32
    %zb = scalar.fptrunc %zf : f32 to bf16
    %eight = index.constant 8 : index
    %tile = index.constant 32 : index
    %pad = index.constant 31 : index
    %rows = config.get @krea2.train_attention_pack.rows : index
    %cols = config.get @krea2.train_attention_pack.cols : index
    %capacity = config.get @krea2.train_attention_pack.capacity : index
    %rounded = index.add %cols, %pad : index
    %tiles = index.div %rounded, %tile : index
    %tr = index.div %group, %tiles : index
    %tc = index.rem %group, %tiles : index
    %br = index.mul %tr, %tile : index
    %bc = index.mul %tc, %tile : index
    %lr = index.div %lane, %tile : index
    %lc = index.rem %lane, %tile : index
    %xg = buffer.assume.memory_space<global> %x : buffer
    %xv = buffer.view %xg[%offset] : buffer -> view<[%n]xbf16>
    %og = buffer.assume.memory_space<global> %out : buffer
    %ov = buffer.view %og[%offset] : buffer -> view<[%capacity]x[%cols]xbf16>
    %tg = buffer.assume.memory_space<global> %transposed : buffer
    %tv = buffer.view %tg[%offset] : buffer -> view<[%cols]x[%capacity]xbf16>
    %bytes = index.constant 2112 : offset
    %storage = buffer.alloca<workgroup> align(16) %bytes : buffer
    %shared = buffer.view %storage[%offset] : buffer -> view<32x33xbf16>
    scf.for %j = [%zero to %tile step %eight] {
      %r = index.add %lr, %j : index
      %ir = index.add %br, %r : index
      %ic = index.add %bc, %lc : index
      %row_ok = index.cmp ult, %ir, %rows : index
      %col_ok = index.cmp ult, %ic, %cols : index
      %value = scf.if %row_ok -> (bf16) {
        %value_col = scf.if %col_ok -> (bf16) {
          %base = index.mul %ir, %cols : index
          %idx = index.add %base, %ic : index
          %i = index.assume %idx [range(%idx, 0, 1073741824), lt(%idx, %n)] : index
          %v = view.load %xv[%i] : view<[%n]xbf16> -> bf16
          scf.yield %v : bf16
        } else {
          scf.yield %zb : bf16
        }
        scf.yield %value_col : bf16
      } else {
        scf.yield %zb : bf16
      }
      %sr = index.assume %r [range(%r, 0, 32)] : index
      %sc = index.assume %lc [range(%lc, 0, 32)] : index
      view.store %value, %shared[%sr, %sc] : bf16, view<32x33xbf16>
      %out_ok = index.cmp ult, %ir, %capacity : index
      scf.if %out_ok {
        scf.if %col_ok {
          %orow = index.assume %ir [lt(%ir, %capacity)] : index
          %ocol = index.assume %ic [lt(%ic, %cols)] : index
          view.store %value, %ov[%orow, %ocol] : bf16, view<[%capacity]x[%cols]xbf16>
        }
      }
      scf.yield
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.for %j = [%zero to %tile step %eight] {
      %r = index.add %lr, %j : index
      %ir = index.add %bc, %r : index
      %ic = index.add %br, %lc : index
      %row_ok = index.cmp ult, %ir, %cols : index
      %col_ok = index.cmp ult, %ic, %capacity : index
      scf.if %row_ok {
        scf.if %col_ok {
          %sr = index.assume %r [range(%r, 0, 32)] : index
          %sc = index.assume %lc [range(%lc, 0, 32)] : index
          %v = view.load %shared[%sc, %sr] : view<32x33xbf16> -> bf16
          %orow = index.assume %ir [lt(%ir, %cols)] : index
          %ocol = index.assume %ic [lt(%ic, %capacity)] : index
          view.store %v, %tv[%orow, %ocol] : bf16, view<[%cols]x[%capacity]xbf16>
        }
      }
      scf.yield
    }
  }
  kernel.return
}
