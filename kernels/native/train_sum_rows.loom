amdgpu.target<gfx11-generic> @krea2_train_sum_rows_target {subgroup_size = 32}
config.decl @krea2.train_sum_rows.rows : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_sum_rows.cols : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_sum_rows.size : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_sum_rows.grid_x : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_sum_rows.grid_y : %value: index where [range(%value, 1, 1073741824)]
kernel.def target(@krea2_train_sum_rows_target) export("krea2_train_sum_rows") @krea2_train_sum_rows(%count: index) {
 %one = index.constant 1 : index
 %threads = index.constant 256 : index
 %gx = config.get @krea2.train_sum_rows.grid_x : index
 %gy = config.get @krea2.train_sum_rows.grid_y : index
 kernel.launch.config workgroups(%gx, %gy, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %x: buffer, %out: buffer) {
 %offset = index.constant 0 : offset
 %zero = index.constant 0 : index
 %one = index.constant 1 : index
 %step = index.constant 256 : index
 %lane = kernel.workitem.id<x> : index
 %group = kernel.workgroup.id<x> : index
 %base = index.mul %group, %step : index
 %col = index.add %base, %lane : index
 %rows = config.get @krea2.train_sum_rows.rows : index
 %cols = config.get @krea2.train_sum_rows.cols : index
 %size = config.get @krea2.train_sum_rows.size : index
 %xg = buffer.assume.memory_space<global> %x : buffer
 %xv = buffer.view %xg[%offset] : buffer -> view<[%size]xbf16>
 %og = buffer.assume.memory_space<global> %out : buffer
 %ov = buffer.view %og[%offset] : buffer -> view<[%cols]xf32>
 %ok = index.cmp ult, %col, %cols : index
 scf.if %ok {
  %c = index.assume %col [range(%col, 0, 1073741824), lt(%col, %cols)] : index
  %zf = scalar.constant 0.0 : f32
  %sum = scf.for %r = [%zero to %rows step %one](%s = %zf : f32) -> (f32) {
   %rb = index.mul %r, %cols : index
   %at = index.add %rb, %c : index
   %i = index.assume %at [range(%at, 0, 1073741824), lt(%at, %size)] : index
   %bits = view.load %xv[%i] : view<[%size]xbf16> -> bf16
   %value = scalar.extf %bits : bf16 to f32
   %next = scalar.addf %s, %value : f32
   scf.yield %next : f32
  }
  %old = view.load %ov[%c] : view<[%cols]xf32> -> f32
  %total = scalar.addf %old, %sum : f32
  view.store %total, %ov[%c] : f32, view<[%cols]xf32>
 }
 kernel.return
}
