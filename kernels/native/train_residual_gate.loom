// Vectorized forward residual gate.
// Preserve the intermediate BF16 rounding before the final operation.
amdgpu.target<gfx11-generic> @target {subgroup_size = 32}
config.decl @krea2.train_residual_gate.grid_x : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_residual_gate.grid_y : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_residual_gate.cols : %value: index where [range(%value, 1, 1073741824)]
kernel.def target(@target) export("krea2_train_residual_gate") @krea2_train_residual_gate(%count: index) {
 %one = index.constant 1 : index
 %threads = index.constant 256 : index
 %gx = config.get @krea2.train_residual_gate.grid_x : index
 %gy = config.get @krea2.train_residual_gate.grid_y : index
 kernel.launch.config workgroups(%gx, %gy, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %residual: buffer, %value: buffer, %modulation: buffer, %out: buffer) {
 %off = index.constant 0 : offset
 %c4 = index.constant 4 : index
 %step = index.constant 1024 : index
 %n = index.assume %count [range(%count, 4, 1073741824), mul(%count, 4)] : index
 %lane = kernel.workitem.id<x> : index
 %group = kernel.workgroup.id<x> : index
 %base = index.mul %group, %step : index
 %local = index.mul %lane, %c4 : index
 %at = index.add %base, %local : index
 %cols0 = config.get @krea2.train_residual_gate.cols : index
 %cols = index.assume %cols0 [range(%cols0, 4, 1073741824), mul(%cols0, 4)] : index
 %residualg = buffer.assume.memory_space<global> %residual : buffer
 %residualv = buffer.view %residualg[%off] : buffer -> view<[%n]xbf16>
 %valueg = buffer.assume.memory_space<global> %value : buffer
 %valuev = buffer.view %valueg[%off] : buffer -> view<[%n]xbf16>
 %modulationg = buffer.assume.memory_space<global> %modulation : buffer
 %modulationv = buffer.view %modulationg[%off] : buffer -> view<[%cols]xbf16>
 %outg = buffer.assume.memory_space<global> %out : buffer
 %outv = buffer.view %outg[%off] : buffer -> view<[%n]xbf16>
 %ok = index.cmp ult, %at, %n : index
 scf.if %ok {
 %limit = index.sub %n, %c4 : index
 %i = index.assume %at [range(%at, 0, 1073741823), le(%at, %limit), mul(%at, 4)] : index
 %vb = vector.load %valuev[%i] : view<[%n]xbf16> -> vector<4xbf16>
 %vf = vector.extf %vb : vector<4xbf16> to vector<4xf32>
 %col0 = index.rem %i, %cols : index
 %col_limit = index.sub %cols, %c4 : index
 %col = index.assume %col0 [range(%col0, 0, 1073741823), le(%col0, %col_limit), mul(%col0, 4)] : index
 %mb = vector.load %modulationv[%col] : view<[%cols]xbf16> -> vector<4xbf16>
 %mf = vector.extf %mb : vector<4xbf16> to vector<4xf32>
 %product = vector.mulf %vf, %mf : vector<4xf32>
 %pb = vector.fptrunc %product : vector<4xf32> to vector<4xbf16>
 %pf = vector.extf %pb : vector<4xbf16> to vector<4xf32>
 %rb = vector.load %residualv[%i] : view<[%n]xbf16> -> vector<4xbf16>
 %rf = vector.extf %rb : vector<4xbf16> to vector<4xf32>
 %sum = vector.addf %rf, %pf : vector<4xf32>
 %output = vector.fptrunc %sum : vector<4xf32> to vector<4xbf16>
 vector.store %output, %outv[%i] : vector<4xbf16>, view<[%n]xbf16>
 }
 kernel.return
}
