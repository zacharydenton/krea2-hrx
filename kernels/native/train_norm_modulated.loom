// RMSNorm + broadcast modulation. Retain normalized BF16 values for modulation gradients.
// Preserve the norm_0 reduction tree and every BF16 rounding boundary.
amdgpu.target<gfx11-generic> @krea2_train_norm_modulated_target {subgroup_size = 32}

config.decl @krea2.train_norm_modulated.xsize : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.train_norm_modulated.cols : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.train_norm_modulated.grid_x : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.train_norm_modulated.grid_y : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@krea2_train_norm_modulated_target) export("krea2_train_norm_modulated") @krea2_train_norm_modulated(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %grid_x = config.get @krea2.train_norm_modulated.grid_x : index
  %grid_y = config.get @krea2.train_norm_modulated.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %eps: f32, %x: buffer, %w: buffer, %y: buffer, %modulation: buffer, %shift: buffer, %out: buffer) {
  %v1 = index.constant 256 : index
  %v5 = scalar.constant 0.0 : f32
  %v19 = index.constant 128 : index
  %v25 = index.constant 64 : index
  %v31 = index.constant 32 : index
  %v37 = index.constant 16 : index
  %v43 = index.constant 8 : index
  %v49 = index.constant 4 : index
  %v55 = index.constant 2 : index
  %v61 = index.constant 1 : index
  %v68 = index.constant 0 : index
  %v82 = scalar.constant 1.0 : f32
  %zero_offset = index.constant 0 : offset
  %count_b = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %xsize = config.get @krea2.train_norm_modulated.xsize : index
  %cols = config.get @krea2.train_norm_modulated.cols : index
  %v2 = index.mul %group, %v1 : index
  %v3 = index.add %v2, %lane : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %x_view = buffer.view %x_global[%zero_offset] : buffer -> view<[%xsize]xbf16>
  %w_global = buffer.assume.memory_space<global> %w : buffer
  %w_view = buffer.view %w_global[%zero_offset] : buffer -> view<[%cols]xf32>
  %y_global = buffer.assume.memory_space<global> %y : buffer
  %y_view = buffer.view %y_global[%zero_offset] : buffer -> view<[%xsize]xbf16>
  %mod_global = buffer.assume.memory_space<global> %modulation : buffer
  %modv = buffer.view %mod_global[%zero_offset] : buffer -> view<[%cols]xbf16>
  %shift_global = buffer.assume.memory_space<global> %shift : buffer
  %shiftv = buffer.view %shift_global[%zero_offset] : buffer -> view<[%cols]xbf16>
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %outv = buffer.view %out_global[%zero_offset] : buffer -> view<[%xsize]xbf16>
  %v4 = index.mul %group, %cols : index
  %v8 = scf.for %v6 = [%lane to %cols step %v1](%v7 = %v5 : f32) -> (f32) {
    %v9 = index.add %v4, %v6 : index
    %v10 = index.assume %v9 [range(%v9, 0, 1073741824), lt(%v9, %xsize)] : index
    %v11 = view.load %x_view[%v10] : view<[%xsize]xbf16> -> bf16
    %v12 = scalar.extf %v11 : bf16 to f32
    %v13 = index.add %v4, %v6 : index
    %v14 = index.assume %v13 [range(%v13, 0, 1073741824), lt(%v13, %xsize)] : index
    %v15 = view.load %x_view[%v14] : view<[%xsize]xbf16> -> bf16
    %v16 = scalar.extf %v15 : bf16 to f32
    %v17 = scalar.mulf %v12, %v16 : f32
    %v18 = scalar.addf %v7, %v17 : f32
    scf.yield %v18 : f32
  }
  %lds_bytes = index.constant 1024 : offset
  %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %sums = buffer.view %lds[%zero_offset] : buffer -> view<256xf32>
  view.store %v8, %sums[%lane] : f32, view<256xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  // Each wave reconstructs the original 256-thread tree, then broadcasts lane zero.
  %l = kernel.subgroup.lane.id : index
  %off0 = index.constant 0 : index
  %i0 = index.add %l, %off0 : index
  %s0 = view.load %sums[%i0] : view<256xf32> -> f32
  %off32 = index.constant 32 : index
  %i32 = index.add %l, %off32 : index
  %s32 = view.load %sums[%i32] : view<256xf32> -> f32
  %off64 = index.constant 64 : index
  %i64 = index.add %l, %off64 : index
  %s64 = view.load %sums[%i64] : view<256xf32> -> f32
  %off96 = index.constant 96 : index
  %i96 = index.add %l, %off96 : index
  %s96 = view.load %sums[%i96] : view<256xf32> -> f32
  %off128 = index.constant 128 : index
  %i128 = index.add %l, %off128 : index
  %s128 = view.load %sums[%i128] : view<256xf32> -> f32
  %off160 = index.constant 160 : index
  %i160 = index.add %l, %off160 : index
  %s160 = view.load %sums[%i160] : view<256xf32> -> f32
  %off192 = index.constant 192 : index
  %i192 = index.add %l, %off192 : index
  %s192 = view.load %sums[%i192] : view<256xf32> -> f32
  %off224 = index.constant 224 : index
  %i224 = index.add %l, %off224 : index
  %s224 = view.load %sums[%i224] : view<256xf32> -> f32
  %a = scalar.addf %s0, %s128 : f32
  %b = scalar.addf %s64, %s192 : f32
  %c = scalar.addf %s32, %s160 : f32
  %d = scalar.addf %s96, %s224 : f32
  %ab = scalar.addf %a, %b : f32
  %cd = scalar.addf %c, %d : f32
  %abcd = scalar.addf %ab, %cd : f32
  %warp = scalar.constant 32 : i32
  %xor16 = scalar.constant 16 : i32
  %peer16, %valid16 = kernel.subgroup.shuffle<xor> %abcd, %xor16, %warp : f32, i32, i32
  %sum16 = scalar.addf %abcd, %peer16 : f32
  %xor8 = scalar.constant 8 : i32
  %peer8, %valid8 = kernel.subgroup.shuffle<xor> %sum16, %xor8, %warp : f32, i32, i32
  %sum8 = scalar.addf %sum16, %peer8 : f32
  %xor4 = scalar.constant 4 : i32
  %peer4, %valid4 = kernel.subgroup.shuffle<xor> %sum8, %xor4, %warp : f32, i32, i32
  %sum4 = scalar.addf %sum8, %peer4 : f32
  %xor2 = scalar.constant 2 : i32
  %peer2, %valid2 = kernel.subgroup.shuffle<xor> %sum4, %xor2, %warp : f32, i32, i32
  %sum2 = scalar.addf %sum4, %peer2 : f32
  %xor1 = scalar.constant 1 : i32
  %peer1, %valid1 = kernel.subgroup.shuffle<xor> %sum2, %xor1, %warp : f32, i32, i32
  %sum1 = scalar.addf %sum2, %peer1 : f32
  %leader = scalar.constant 0 : i32
  %v67, %valid = kernel.subgroup.shuffle<index> %sum1, %leader, %warp : f32, i32, i32
  %v69 = index.cast %cols : index to i32
  %v70 = scalar.sitofp %v69 : i32 to f32
  %v71 = scalar.divf %v67, %v70 : f32
  %v72 = scalar.addf %v71, %eps : f32
  %v73 = scalar.rsqrtf %v72 : f32
  scf.for %v74 = [%lane to %cols step %v1] {
    %v75 = index.add %v4, %v74 : index
    %v76 = index.assume %v75 [range(%v75, 0, 1073741824), lt(%v75, %xsize)] : index
    %v77 = view.load %x_view[%v76] : view<[%xsize]xbf16> -> bf16
    %v78 = scalar.extf %v77 : bf16 to f32
    %v79 = scalar.mulf %v78, %v73 : f32
    %v80 = index.assume %v74 [range(%v74, 0, 1073741824), lt(%v74, %cols)] : index
    %v81 = view.load %w_view[%v80] : view<[%cols]xf32> -> f32
    %v83 = scalar.addf %v82, %v81 : f32
    %v84 = scalar.mulf %v79, %v83 : f32
    %v85 = index.add %v4, %v74 : index
    %v86 = scalar.fptrunc %v84 : f32 to bf16
    %v87 = index.assume %v85 [range(%v85, 0, 1073741824), lt(%v85, %xsize)] : index
    view.store %v86, %y_view[%v87] : bf16, view<[%xsize]xbf16>
    %normf = scalar.extf %v86 : bf16 to f32
    %modbits = view.load %modv[%v80] : view<[%cols]xbf16> -> bf16
    %modf = scalar.extf %modbits : bf16 to f32
    %plus = scalar.addf %v82, %modf : f32
    %plusbf = scalar.fptrunc %plus : f32 to bf16
    %plusf = scalar.extf %plusbf : bf16 to f32
    %scaled = scalar.mulf %normf, %plusf : f32
    %scaledbf = scalar.fptrunc %scaled : f32 to bf16
    %scaledf = scalar.extf %scaledbf : bf16 to f32
    %shiftbits = view.load %shiftv[%v80] : view<[%cols]xbf16> -> bf16
    %shiftf = scalar.extf %shiftbits : bf16 to f32
    %sum = scalar.addf %scaledf, %shiftf : f32
    %sumbf = scalar.fptrunc %sum : f32 to bf16
    view.store %sumbf, %outv[%v87] : bf16, view<[%xsize]xbf16>
  }
  kernel.return
}
