amdgpu.target<gfx11-generic> @krea2_train_transpose_target {subgroup_size = 32}

config.decl @krea2.train_transpose.rows : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_transpose.cols : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_transpose.grid_x : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_transpose.grid_y : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@krea2_train_transpose_target) export("krea2_train_transpose") @krea2_train_transpose(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %grid_x = config.get @krea2.train_transpose.grid_x : index
  %grid_y = config.get @krea2.train_transpose.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %x: buffer, %out: buffer) {
  %zero_offset = index.constant 0 : offset
  %n = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %step = index.constant 256 : index
  %base = index.mul %group, %step : index
  %idx = index.add %base, %lane : index
  %rows = config.get @krea2.train_transpose.rows : index
  %cols = config.get @krea2.train_transpose.cols : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %xv = buffer.view %x_global[%zero_offset] : buffer -> view<[%n]xbf16>
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %outv = buffer.view %out_global[%zero_offset] : buffer -> view<[%n]xbf16>
  %ok = index.cmp ult, %idx, %n : index
  scf.if %ok {
    %i = index.assume %idx [range(%idx, 0, 1073741824), lt(%idx, %n)] : index
    %r = index.div %i, %cols : index
    %c = index.rem %i, %cols : index
    %cb = index.mul %c, %rows : index
    %oi = index.add %cb, %r : index
    %o = index.assume %oi [range(%oi, 0, 1073741824), lt(%oi, %n)] : index
    %value = view.load %xv[%i] : view<[%n]xbf16> -> bf16
    view.store %value, %outv[%o] : bf16, view<[%n]xbf16>
  }
  kernel.return
}
