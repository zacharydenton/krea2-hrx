// Fused inverse rotary and Q/K RMSNorm backward, one head per wave.
// Adjacent lanes exchange rotary partners; retain the intermediate BF16 rounding.
// Each wave retains the original FP32 summation and shuffle order.
amdgpu.target<gfx11-generic> @krea2_train_rope_norm_backward_target {subgroup_size = 32}

config.decl @krea2.train_rope_norm_backward.cols : %value: index where [range(%value, 128, 128)]
config.decl @krea2.train_rope_norm_backward.heads : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_rope_norm_backward.tables : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_rope_norm_backward.size : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_rope_norm_backward.grid_x : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_rope_norm_backward.grid_y : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@krea2_train_rope_norm_backward_target) export("krea2_train_rope_norm_backward") @krea2_train_rope_norm_backward(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  %grid_x = config.get @krea2.train_rope_norm_backward.grid_x : index
  %grid_y = config.get @krea2.train_rope_norm_backward.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %eps: f32, %x: buffer, %grad: buffer, %w: buffer, %cos: buffer, %sin: buffer, %out: buffer) {
  %zero_offset = index.constant 0 : offset
  %n = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.subgroup.lane.id : index
  %group = kernel.workgroup.id<x> : index
  %cols = config.get @krea2.train_rope_norm_backward.cols : index
  %size = config.get @krea2.train_rope_norm_backward.size : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %xv = buffer.view %x_global[%zero_offset] : buffer -> view<[%size]xbf16>
  %grad_global = buffer.assume.memory_space<global> %grad : buffer
  %gradv = buffer.view %grad_global[%zero_offset] : buffer -> view<[%size]xbf16>
  %w_global = buffer.assume.memory_space<global> %w : buffer
  %wv = buffer.view %w_global[%zero_offset] : buffer -> view<[%cols]xf32>
  %heads = config.get @krea2.train_rope_norm_backward.heads : index
  %tables = config.get @krea2.train_rope_norm_backward.tables : index
  %cg = buffer.assume.memory_space<global> %cos : buffer
  %cv = buffer.view %cg[%zero_offset] : buffer -> view<[%tables]xf32>
  %sg = buffer.assume.memory_space<global> %sin : buffer
  %sv = buffer.view %sg[%zero_offset] : buffer -> view<[%tables]xf32>
  %token = index.div %group, %heads : index
  %tablebase = index.mul %token, %cols : index
  %twoi = index.constant 2 : index
  %parity = index.rem %lane, %twoi : index
  %parityi = index.cast %parity : index to i32
  %parityf = scalar.sitofp %parityi : i32 to f32
  %twof = scalar.constant 2.0 : f32
  %unit = scalar.constant 1.0 : f32
  %twop = scalar.mulf %parityf, %twof : f32
  %sign = scalar.subf %unit, %twop : f32
  %partner_offset = scalar.constant 1 : i32
  %warp_width = scalar.constant 32 : i32
  %out_global = buffer.assume.memory_space<global> %out : buffer
  %outv = buffer.view %out_global[%zero_offset] : buffer -> view<[%size]xbf16>
  %zero = scalar.constant 0.0 : f32
  %onef = scalar.constant 1.0 : f32
  %width = index.cast %cols : index to i32
  %widthf = scalar.sitofp %width : i32 to f32
  %rowbase = index.mul %group, %cols : index
  %off0 = index.constant 0 : index
  %col0 = index.add %lane, %off0 : index
  %wi0 = index.assume %col0 [range(%col0, 0, 127), lt(%col0, %cols)] : index
  %at0 = index.add %rowbase, %wi0 : index
  %idx0 = index.assume %at0 [range(%at0, 0, 1073741824), lt(%at0, %size)] : index
  %xb0 = view.load %xv[%idx0] : view<[%size]xbf16> -> bf16
  %cached_x0 = scalar.extf %xb0 : bf16 to f32
  %gb0 = view.load %gradv[%idx0] : view<[%size]xbf16> -> bf16
  %raw0 = scalar.extf %gb0 : bf16 to f32
  %partner0, %valid0 = kernel.subgroup.shuffle<xor> %raw0, %partner_offset, %warp_width : f32, i32, i32
  %tableat0 = index.add %tablebase, %wi0 : index
  %ti0 = index.assume %tableat0 [range(%tableat0, 0, 1073741824), lt(%tableat0, %tables)] : index
  %cos0 = view.load %cv[%ti0] : view<[%tables]xf32> -> f32
  %sin0 = view.load %sv[%ti0] : view<[%tables]xf32> -> f32
  %ys0 = scalar.mulf %partner0, %sin0 : f32
  %rotated0 = scalar.mulf %ys0, %sign : f32
  %xc0 = scalar.mulf %raw0, %cos0 : f32
  %rotary0 = scalar.addf %xc0, %rotated0 : f32
  %rotary_bits0 = scalar.fptrunc %rotary0 : f32 to bf16
  %gf0 = scalar.extf %rotary_bits0 : bf16 to f32
  %ww0 = view.load %wv[%wi0] : view<[%cols]xf32> -> f32
  %scale0 = scalar.addf %onef, %ww0 : f32
  %cached_d0 = scalar.mulf %gf0, %scale0 : f32
  %square0 = scalar.mulf %cached_x0, %cached_x0 : f32
  %dot0 = scalar.mulf %cached_x0, %cached_d0 : f32
  %ss0 = scalar.addf %zero, %square0 : f32
  %gg0 = scalar.addf %zero, %dot0 : f32
  %off1 = index.constant 32 : index
  %col1 = index.add %lane, %off1 : index
  %wi1 = index.assume %col1 [range(%col1, 0, 127), lt(%col1, %cols)] : index
  %at1 = index.add %rowbase, %wi1 : index
  %idx1 = index.assume %at1 [range(%at1, 0, 1073741824), lt(%at1, %size)] : index
  %xb1 = view.load %xv[%idx1] : view<[%size]xbf16> -> bf16
  %cached_x1 = scalar.extf %xb1 : bf16 to f32
  %gb1 = view.load %gradv[%idx1] : view<[%size]xbf16> -> bf16
  %raw1 = scalar.extf %gb1 : bf16 to f32
  %partner1, %valid1 = kernel.subgroup.shuffle<xor> %raw1, %partner_offset, %warp_width : f32, i32, i32
  %tableat1 = index.add %tablebase, %wi1 : index
  %ti1 = index.assume %tableat1 [range(%tableat1, 0, 1073741824), lt(%tableat1, %tables)] : index
  %cos1 = view.load %cv[%ti1] : view<[%tables]xf32> -> f32
  %sin1 = view.load %sv[%ti1] : view<[%tables]xf32> -> f32
  %ys1 = scalar.mulf %partner1, %sin1 : f32
  %rotated1 = scalar.mulf %ys1, %sign : f32
  %xc1 = scalar.mulf %raw1, %cos1 : f32
  %rotary1 = scalar.addf %xc1, %rotated1 : f32
  %rotary_bits1 = scalar.fptrunc %rotary1 : f32 to bf16
  %gf1 = scalar.extf %rotary_bits1 : bf16 to f32
  %ww1 = view.load %wv[%wi1] : view<[%cols]xf32> -> f32
  %scale1 = scalar.addf %onef, %ww1 : f32
  %cached_d1 = scalar.mulf %gf1, %scale1 : f32
  %square1 = scalar.mulf %cached_x1, %cached_x1 : f32
  %dot1 = scalar.mulf %cached_x1, %cached_d1 : f32
  %ss1 = scalar.addf %ss0, %square1 : f32
  %gg1 = scalar.addf %gg0, %dot1 : f32
  %off2 = index.constant 64 : index
  %col2 = index.add %lane, %off2 : index
  %wi2 = index.assume %col2 [range(%col2, 0, 127), lt(%col2, %cols)] : index
  %at2 = index.add %rowbase, %wi2 : index
  %idx2 = index.assume %at2 [range(%at2, 0, 1073741824), lt(%at2, %size)] : index
  %xb2 = view.load %xv[%idx2] : view<[%size]xbf16> -> bf16
  %cached_x2 = scalar.extf %xb2 : bf16 to f32
  %gb2 = view.load %gradv[%idx2] : view<[%size]xbf16> -> bf16
  %raw2 = scalar.extf %gb2 : bf16 to f32
  %partner2, %valid2 = kernel.subgroup.shuffle<xor> %raw2, %partner_offset, %warp_width : f32, i32, i32
  %tableat2 = index.add %tablebase, %wi2 : index
  %ti2 = index.assume %tableat2 [range(%tableat2, 0, 1073741824), lt(%tableat2, %tables)] : index
  %cos2 = view.load %cv[%ti2] : view<[%tables]xf32> -> f32
  %sin2 = view.load %sv[%ti2] : view<[%tables]xf32> -> f32
  %ys2 = scalar.mulf %partner2, %sin2 : f32
  %rotated2 = scalar.mulf %ys2, %sign : f32
  %xc2 = scalar.mulf %raw2, %cos2 : f32
  %rotary2 = scalar.addf %xc2, %rotated2 : f32
  %rotary_bits2 = scalar.fptrunc %rotary2 : f32 to bf16
  %gf2 = scalar.extf %rotary_bits2 : bf16 to f32
  %ww2 = view.load %wv[%wi2] : view<[%cols]xf32> -> f32
  %scale2 = scalar.addf %onef, %ww2 : f32
  %cached_d2 = scalar.mulf %gf2, %scale2 : f32
  %square2 = scalar.mulf %cached_x2, %cached_x2 : f32
  %dot2 = scalar.mulf %cached_x2, %cached_d2 : f32
  %ss2 = scalar.addf %ss1, %square2 : f32
  %gg2 = scalar.addf %gg1, %dot2 : f32
  %off3 = index.constant 96 : index
  %col3 = index.add %lane, %off3 : index
  %wi3 = index.assume %col3 [range(%col3, 0, 127), lt(%col3, %cols)] : index
  %at3 = index.add %rowbase, %wi3 : index
  %idx3 = index.assume %at3 [range(%at3, 0, 1073741824), lt(%at3, %size)] : index
  %xb3 = view.load %xv[%idx3] : view<[%size]xbf16> -> bf16
  %cached_x3 = scalar.extf %xb3 : bf16 to f32
  %gb3 = view.load %gradv[%idx3] : view<[%size]xbf16> -> bf16
  %raw3 = scalar.extf %gb3 : bf16 to f32
  %partner3, %valid3 = kernel.subgroup.shuffle<xor> %raw3, %partner_offset, %warp_width : f32, i32, i32
  %tableat3 = index.add %tablebase, %wi3 : index
  %ti3 = index.assume %tableat3 [range(%tableat3, 0, 1073741824), lt(%tableat3, %tables)] : index
  %cos3 = view.load %cv[%ti3] : view<[%tables]xf32> -> f32
  %sin3 = view.load %sv[%ti3] : view<[%tables]xf32> -> f32
  %ys3 = scalar.mulf %partner3, %sin3 : f32
  %rotated3 = scalar.mulf %ys3, %sign : f32
  %xc3 = scalar.mulf %raw3, %cos3 : f32
  %rotary3 = scalar.addf %xc3, %rotated3 : f32
  %rotary_bits3 = scalar.fptrunc %rotary3 : f32 to bf16
  %gf3 = scalar.extf %rotary_bits3 : bf16 to f32
  %ww3 = view.load %wv[%wi3] : view<[%cols]xf32> -> f32
  %scale3 = scalar.addf %onef, %ww3 : f32
  %cached_d3 = scalar.mulf %gf3, %scale3 : f32
  %square3 = scalar.mulf %cached_x3, %cached_x3 : f32
  %dot3 = scalar.mulf %cached_x3, %cached_d3 : f32
  %ss = scalar.addf %ss2, %square3 : f32
  %gg = scalar.addf %gg2, %dot3 : f32
  %warp = scalar.constant 32 : i32
  %ssoff16 = scalar.constant 16 : i32
  %sspeer16, %ssvalid16 = kernel.subgroup.shuffle<xor> %ss, %ssoff16, %warp : f32, i32, i32
  %sssum16 = scalar.addf %ss, %sspeer16 : f32
  %ssoff8 = scalar.constant 8 : i32
  %sspeer8, %ssvalid8 = kernel.subgroup.shuffle<xor> %sssum16, %ssoff8, %warp : f32, i32, i32
  %sssum8 = scalar.addf %sssum16, %sspeer8 : f32
  %ssoff4 = scalar.constant 4 : i32
  %sspeer4, %ssvalid4 = kernel.subgroup.shuffle<xor> %sssum8, %ssoff4, %warp : f32, i32, i32
  %sssum4 = scalar.addf %sssum8, %sspeer4 : f32
  %ssoff2 = scalar.constant 2 : i32
  %sspeer2, %ssvalid2 = kernel.subgroup.shuffle<xor> %sssum4, %ssoff2, %warp : f32, i32, i32
  %sssum2 = scalar.addf %sssum4, %sspeer2 : f32
  %ssoff1 = scalar.constant 1 : i32
  %sspeer1, %ssvalid1 = kernel.subgroup.shuffle<xor> %sssum2, %ssoff1, %warp : f32, i32, i32
  %sssum1 = scalar.addf %sssum2, %sspeer1 : f32
  %ggoff16 = scalar.constant 16 : i32
  %ggpeer16, %ggvalid16 = kernel.subgroup.shuffle<xor> %gg, %ggoff16, %warp : f32, i32, i32
  %ggsum16 = scalar.addf %gg, %ggpeer16 : f32
  %ggoff8 = scalar.constant 8 : i32
  %ggpeer8, %ggvalid8 = kernel.subgroup.shuffle<xor> %ggsum16, %ggoff8, %warp : f32, i32, i32
  %ggsum8 = scalar.addf %ggsum16, %ggpeer8 : f32
  %ggoff4 = scalar.constant 4 : i32
  %ggpeer4, %ggvalid4 = kernel.subgroup.shuffle<xor> %ggsum8, %ggoff4, %warp : f32, i32, i32
  %ggsum4 = scalar.addf %ggsum8, %ggpeer4 : f32
  %ggoff2 = scalar.constant 2 : i32
  %ggpeer2, %ggvalid2 = kernel.subgroup.shuffle<xor> %ggsum4, %ggoff2, %warp : f32, i32, i32
  %ggsum2 = scalar.addf %ggsum4, %ggpeer2 : f32
  %ggoff1 = scalar.constant 1 : i32
  %ggpeer1, %ggvalid1 = kernel.subgroup.shuffle<xor> %ggsum2, %ggoff1, %warp : f32, i32, i32
  %ggsum1 = scalar.addf %ggsum2, %ggpeer1 : f32
  %mean = scalar.divf %sssum1, %widthf : f32
  %variance = scalar.addf %mean, %eps : f32
  %root = scalar.sqrtf %variance : f32
  %inv = scalar.divf %onef, %root : f32
  %dotmean = scalar.divf %ggsum1, %widthf : f32
  %correction = scalar.divf %dotmean, %variance : f32
  %outoff0 = index.constant 0 : index
  %outcol0 = index.add %lane, %outoff0 : index
  %outat0 = index.add %rowbase, %outcol0 : index
  %outi0 = index.assume %outat0 [range(%outat0, 0, 1073741824), lt(%outat0, %size)] : index
  %corr0 = scalar.mulf %cached_x0, %correction : f32
  %centered0 = scalar.subf %cached_d0, %corr0 : f32
  %result0 = scalar.mulf %centered0, %inv : f32
  %rounded0 = scalar.fptrunc %result0 : f32 to bf16
  view.store %rounded0, %outv[%outi0] : bf16, view<[%size]xbf16>
  %outoff1 = index.constant 32 : index
  %outcol1 = index.add %lane, %outoff1 : index
  %outat1 = index.add %rowbase, %outcol1 : index
  %outi1 = index.assume %outat1 [range(%outat1, 0, 1073741824), lt(%outat1, %size)] : index
  %corr1 = scalar.mulf %cached_x1, %correction : f32
  %centered1 = scalar.subf %cached_d1, %corr1 : f32
  %result1 = scalar.mulf %centered1, %inv : f32
  %rounded1 = scalar.fptrunc %result1 : f32 to bf16
  view.store %rounded1, %outv[%outi1] : bf16, view<[%size]xbf16>
  %outoff2 = index.constant 64 : index
  %outcol2 = index.add %lane, %outoff2 : index
  %outat2 = index.add %rowbase, %outcol2 : index
  %outi2 = index.assume %outat2 [range(%outat2, 0, 1073741824), lt(%outat2, %size)] : index
  %corr2 = scalar.mulf %cached_x2, %correction : f32
  %centered2 = scalar.subf %cached_d2, %corr2 : f32
  %result2 = scalar.mulf %centered2, %inv : f32
  %rounded2 = scalar.fptrunc %result2 : f32 to bf16
  view.store %rounded2, %outv[%outi2] : bf16, view<[%size]xbf16>
  %outoff3 = index.constant 96 : index
  %outcol3 = index.add %lane, %outoff3 : index
  %outat3 = index.add %rowbase, %outcol3 : index
  %outi3 = index.assume %outat3 [range(%outat3, 0, 1073741824), lt(%outat3, %size)] : index
  %corr3 = scalar.mulf %cached_x3, %correction : f32
  %centered3 = scalar.subf %cached_d3, %corr3 : f32
  %result3 = scalar.mulf %centered3, %inv : f32
  %rounded3 = scalar.fptrunc %result3 : f32 to bf16
  view.store %rounded3, %outv[%outi3] : bf16, view<[%size]xbf16>
  kernel.return
}
