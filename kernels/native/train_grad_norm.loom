amdgpu.target<gfx11-generic> @krea2_train_grad_norm_target {subgroup_size = 32}
config.decl @krea2.train_grad_norm.parts : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_grad_norm.grid_x : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_grad_norm.grid_y : %value: index where [range(%value, 1, 1073741824)]
kernel.def target(@krea2_train_grad_norm_target) export("krea2_train_grad_norm") @krea2_train_grad_norm(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 32 : index
  %gx = config.get @krea2.train_grad_norm.grid_x : index
  %gy = config.get @krea2.train_grad_norm.grid_y : index
  kernel.launch.config workgroups(%gx, %gy, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %grad: buffer, %out: buffer) {
  %zero_offset = index.constant 0 : offset
  %zero = index.constant 0 : index
  %zerof = scalar.constant 0.0 : f32
  %step = index.constant 32 : index
  %chunk = index.constant 1024 : index
  %n = index.assume %count [range(%count, 1, 1073741824)] : index
  %parts = config.get @krea2.train_grad_norm.parts : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %base = index.mul %group, %chunk : index
  %gg = buffer.assume.memory_space<global> %grad : buffer
  %gv = buffer.view %gg[%zero_offset] : buffer -> view<[%n]xf32>
  %og = buffer.assume.memory_space<global> %out : buffer
  %ov = buffer.view %og[%zero_offset] : buffer -> view<[%parts]xf32>
  %sum = scf.for %j = [%lane to %chunk step %step](%acc = %zerof : f32) -> (f32) {
    %idx = index.add %base, %j : index
    %ok = index.cmp ult, %idx, %n : index
    %value = scf.if %ok -> (f32) {
      %i = index.assume %idx [range(%idx, 0, 1073741824), lt(%idx, %n)] : index
      %g = view.load %gv[%i] : view<[%n]xf32> -> f32
      %square = scalar.mulf %g, %g : f32
      scf.yield %square : f32
    } else {
      scf.yield %zerof : f32
    }
    %next = scalar.addf %acc, %value : f32
    scf.yield %next : f32
  }
  %warp = scalar.constant 32 : i32
  %s16 = scalar.constant 16 : i32
  %s8 = scalar.constant 8 : i32
  %s4 = scalar.constant 4 : i32
  %s2 = scalar.constant 2 : i32
  %s1 = scalar.constant 1 : i32
  %p16, %v16 = kernel.subgroup.shuffle<xor> %sum, %s16, %warp : f32, i32, i32
  %a16 = scalar.addf %sum, %p16 : f32
  %p8, %v8 = kernel.subgroup.shuffle<xor> %a16, %s8, %warp : f32, i32, i32
  %a8 = scalar.addf %a16, %p8 : f32
  %p4, %v4 = kernel.subgroup.shuffle<xor> %a8, %s4, %warp : f32, i32, i32
  %a4 = scalar.addf %a8, %p4 : f32
  %p2, %v2 = kernel.subgroup.shuffle<xor> %a4, %s2, %warp : f32, i32, i32
  %a2 = scalar.addf %a4, %p2 : f32
  %p1, %v1 = kernel.subgroup.shuffle<xor> %a2, %s1, %warp : f32, i32, i32
  %a1 = scalar.addf %a2, %p1 : f32
  %first = index.cmp eq, %lane, %zero : index
  scf.if %first {
    %oi = index.assume %group [range(%group, 0, 1073741824), lt(%group, %parts)] : index
    view.store %a1, %ov[%oi] : f32, view<[%parts]xf32>
  }
  kernel.return
}
