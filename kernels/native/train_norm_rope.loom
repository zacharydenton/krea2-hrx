// Q/K RMSNorm and rotary in one pass, eight 128-channel heads per workgroup.
// Cache each head in wave registers; preserve norm_0's FP32 reduction tree and
// BF16 normalization rounding before exchanging adjacent rotary partners.
amdgpu.target<gfx11-generic> @target {subgroup_size = 32}
config.decl @krea2.train_norm_rope.heads : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_norm_rope.tables : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_norm_rope.size : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_norm_rope.grid_x : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_norm_rope.grid_y : %value: index where [range(%value, 1, 1073741824)]
kernel.def target(@target) export("krea2_train_norm_rope") @krea2_train_norm_rope(%count: index) {
 %one = index.constant 1 : index
 %threads = index.constant 256 : index
 %gx = config.get @krea2.train_norm_rope.grid_x : index
 %gy = config.get @krea2.train_norm_rope.grid_y : index
 kernel.launch.config workgroups(%gx, %gy, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %eps: f32, %x: buffer, %w: buffer, %cos: buffer, %sin: buffer, %out: buffer) {
 %off = index.constant 0 : offset
 %c8 = index.constant 8 : index
 %c128 = index.constant 128 : index
 %lane = kernel.subgroup.lane.id : index
 %wave = kernel.subgroup.id : index
 %group = kernel.workgroup.id<x> : index
 %rows = index.assume %count [range(%count, 1, 1073741824)] : index
 %row0 = index.mul %group, %c8 : index
 %row = index.add %row0, %wave : index
 %valid = index.cmp ult, %row, %rows : index
 scf.if %valid {
 %headrow = index.assume %row [range(%row, 0, 1073741824), lt(%row, %rows)] : index
 %base = index.mul %headrow, %c128 : index
 %heads = config.get @krea2.train_norm_rope.heads : index
 %tables = config.get @krea2.train_norm_rope.tables : index
 %size = config.get @krea2.train_norm_rope.size : index
 %token = index.div %headrow, %heads : index
 %tablebase = index.mul %token, %c128 : index
 %warp = scalar.constant 32 : i32
 %zero = scalar.constant 0.0 : f32
 %one = scalar.constant 1.0 : f32
 %width = scalar.constant 128.0 : f32
 %partner_offset = scalar.constant 1 : i32
 %twoi = index.constant 2 : index
 %parity = index.rem %lane, %twoi : index
 %parityi = index.cast %parity : index to i32
 %parityf = scalar.sitofp %parityi : i32 to f32
 %two = scalar.constant 2.0 : f32
 %twop = scalar.mulf %parityf, %two : f32
 %sign = scalar.subf %twop, %one : f32
 %xg = buffer.assume.memory_space<global> %x : buffer
 %xv = buffer.view %xg[%off] : buffer -> view<[%size]xbf16>
 %wg = buffer.assume.memory_space<global> %w : buffer
 %wv = buffer.view %wg[%off] : buffer -> view<128xf32>
 %cosg = buffer.assume.memory_space<global> %cos : buffer
 %cosv = buffer.view %cosg[%off] : buffer -> view<[%tables]xf32>
 %sing = buffer.assume.memory_space<global> %sin : buffer
 %sinv = buffer.view %sing[%off] : buffer -> view<[%tables]xf32>
 %outg = buffer.assume.memory_space<global> %out : buffer
 %outv = buffer.view %outg[%off] : buffer -> view<[%size]xbf16>
 %offset0 = index.constant 0 : index
 %col0 = index.add %lane, %offset0 : index
 %at0 = index.add %base, %col0 : index
 %i0 = index.assume %at0 [range(%at0, 0, 1073741824), lt(%at0, %size)] : index
 %xb0 = view.load %xv[%i0] : view<[%size]xbf16> -> bf16
 %xf0 = scalar.extf %xb0 : bf16 to f32
 %sq0 = scalar.mulf %xf0, %xf0 : f32
 %s0 = scalar.addf %zero, %sq0 : f32
 %offset1 = index.constant 32 : index
 %col1 = index.add %lane, %offset1 : index
 %at1 = index.add %base, %col1 : index
 %i1 = index.assume %at1 [range(%at1, 0, 1073741824), lt(%at1, %size)] : index
 %xb1 = view.load %xv[%i1] : view<[%size]xbf16> -> bf16
 %xf1 = scalar.extf %xb1 : bf16 to f32
 %sq1 = scalar.mulf %xf1, %xf1 : f32
 %s1 = scalar.addf %zero, %sq1 : f32
 %offset2 = index.constant 64 : index
 %col2 = index.add %lane, %offset2 : index
 %at2 = index.add %base, %col2 : index
 %i2 = index.assume %at2 [range(%at2, 0, 1073741824), lt(%at2, %size)] : index
 %xb2 = view.load %xv[%i2] : view<[%size]xbf16> -> bf16
 %xf2 = scalar.extf %xb2 : bf16 to f32
 %sq2 = scalar.mulf %xf2, %xf2 : f32
 %s2 = scalar.addf %zero, %sq2 : f32
 %offset3 = index.constant 96 : index
 %col3 = index.add %lane, %offset3 : index
 %at3 = index.add %base, %col3 : index
 %i3 = index.assume %at3 [range(%at3, 0, 1073741824), lt(%at3, %size)] : index
 %xb3 = view.load %xv[%i3] : view<[%size]xbf16> -> bf16
 %xf3 = scalar.extf %xb3 : bf16 to f32
 %sq3 = scalar.mulf %xf3, %xf3 : f32
 %s3 = scalar.addf %zero, %sq3 : f32
 %even = scalar.addf %s0, %s2 : f32
 %odd = scalar.addf %s1, %s3 : f32
 %total = scalar.addf %even, %odd : f32
 %xo16 = scalar.constant 16 : i32
 %peer16, %valid16 = kernel.subgroup.shuffle<xor> %total, %xo16, %warp : f32, i32, i32
 %sum16 = scalar.addf %total, %peer16 : f32
 %xo8 = scalar.constant 8 : i32
 %peer8, %valid8 = kernel.subgroup.shuffle<xor> %sum16, %xo8, %warp : f32, i32, i32
 %sum8 = scalar.addf %sum16, %peer8 : f32
 %xo4 = scalar.constant 4 : i32
 %peer4, %valid4 = kernel.subgroup.shuffle<xor> %sum8, %xo4, %warp : f32, i32, i32
 %sum4 = scalar.addf %sum8, %peer4 : f32
 %xo2 = scalar.constant 2 : i32
 %peer2, %valid2 = kernel.subgroup.shuffle<xor> %sum4, %xo2, %warp : f32, i32, i32
 %sum2 = scalar.addf %sum4, %peer2 : f32
 %xo1 = scalar.constant 1 : i32
 %peer1, %valid1 = kernel.subgroup.shuffle<xor> %sum2, %xo1, %warp : f32, i32, i32
 %sum1 = scalar.addf %sum2, %peer1 : f32
 %leader = scalar.constant 0 : i32
 %sum, %sumvalid = kernel.subgroup.shuffle<index> %sum1, %leader, %warp : f32, i32, i32
 %mean = scalar.divf %sum, %width : f32
 %variance = scalar.addf %mean, %eps : f32
 %inv = scalar.rsqrtf %variance : f32
 %weight0 = view.load %wv[%col0] : view<128xf32> -> f32
 %scale0 = scalar.addf %one, %weight0 : f32
 %normalized0 = scalar.mulf %xf0, %inv : f32
 %weighted0 = scalar.mulf %normalized0, %scale0 : f32
 %nb0 = scalar.fptrunc %weighted0 : f32 to bf16
 %nf0 = scalar.extf %nb0 : bf16 to f32
 %partner0, %partnervalid0 = kernel.subgroup.shuffle<xor> %nf0, %partner_offset, %warp : f32, i32, i32
 %ta0 = index.add %tablebase, %col0 : index
 %ti0 = index.assume %ta0 [range(%ta0, 0, 1073741824), lt(%ta0, %tables)] : index
 %c0 = view.load %cosv[%ti0] : view<[%tables]xf32> -> f32
 %sn0 = view.load %sinv[%ti0] : view<[%tables]xf32> -> f32
 %ys0 = scalar.mulf %partner0, %sn0 : f32
 %rotated0 = scalar.mulf %ys0, %sign : f32
 %xc0 = scalar.mulf %nf0, %c0 : f32
 %result0 = scalar.addf %xc0, %rotated0 : f32
 %rounded0 = scalar.fptrunc %result0 : f32 to bf16
 view.store %rounded0, %outv[%i0] : bf16, view<[%size]xbf16>
 %weight1 = view.load %wv[%col1] : view<128xf32> -> f32
 %scale1 = scalar.addf %one, %weight1 : f32
 %normalized1 = scalar.mulf %xf1, %inv : f32
 %weighted1 = scalar.mulf %normalized1, %scale1 : f32
 %nb1 = scalar.fptrunc %weighted1 : f32 to bf16
 %nf1 = scalar.extf %nb1 : bf16 to f32
 %partner1, %partnervalid1 = kernel.subgroup.shuffle<xor> %nf1, %partner_offset, %warp : f32, i32, i32
 %ta1 = index.add %tablebase, %col1 : index
 %ti1 = index.assume %ta1 [range(%ta1, 0, 1073741824), lt(%ta1, %tables)] : index
 %c1 = view.load %cosv[%ti1] : view<[%tables]xf32> -> f32
 %sn1 = view.load %sinv[%ti1] : view<[%tables]xf32> -> f32
 %ys1 = scalar.mulf %partner1, %sn1 : f32
 %rotated1 = scalar.mulf %ys1, %sign : f32
 %xc1 = scalar.mulf %nf1, %c1 : f32
 %result1 = scalar.addf %xc1, %rotated1 : f32
 %rounded1 = scalar.fptrunc %result1 : f32 to bf16
 view.store %rounded1, %outv[%i1] : bf16, view<[%size]xbf16>
 %weight2 = view.load %wv[%col2] : view<128xf32> -> f32
 %scale2 = scalar.addf %one, %weight2 : f32
 %normalized2 = scalar.mulf %xf2, %inv : f32
 %weighted2 = scalar.mulf %normalized2, %scale2 : f32
 %nb2 = scalar.fptrunc %weighted2 : f32 to bf16
 %nf2 = scalar.extf %nb2 : bf16 to f32
 %partner2, %partnervalid2 = kernel.subgroup.shuffle<xor> %nf2, %partner_offset, %warp : f32, i32, i32
 %ta2 = index.add %tablebase, %col2 : index
 %ti2 = index.assume %ta2 [range(%ta2, 0, 1073741824), lt(%ta2, %tables)] : index
 %c2 = view.load %cosv[%ti2] : view<[%tables]xf32> -> f32
 %sn2 = view.load %sinv[%ti2] : view<[%tables]xf32> -> f32
 %ys2 = scalar.mulf %partner2, %sn2 : f32
 %rotated2 = scalar.mulf %ys2, %sign : f32
 %xc2 = scalar.mulf %nf2, %c2 : f32
 %result2 = scalar.addf %xc2, %rotated2 : f32
 %rounded2 = scalar.fptrunc %result2 : f32 to bf16
 view.store %rounded2, %outv[%i2] : bf16, view<[%size]xbf16>
 %weight3 = view.load %wv[%col3] : view<128xf32> -> f32
 %scale3 = scalar.addf %one, %weight3 : f32
 %normalized3 = scalar.mulf %xf3, %inv : f32
 %weighted3 = scalar.mulf %normalized3, %scale3 : f32
 %nb3 = scalar.fptrunc %weighted3 : f32 to bf16
 %nf3 = scalar.extf %nb3 : bf16 to f32
 %partner3, %partnervalid3 = kernel.subgroup.shuffle<xor> %nf3, %partner_offset, %warp : f32, i32, i32
 %ta3 = index.add %tablebase, %col3 : index
 %ti3 = index.assume %ta3 [range(%ta3, 0, 1073741824), lt(%ta3, %tables)] : index
 %c3 = view.load %cosv[%ti3] : view<[%tables]xf32> -> f32
 %sn3 = view.load %sinv[%ti3] : view<[%tables]xf32> -> f32
 %ys3 = scalar.mulf %partner3, %sn3 : f32
 %rotated3 = scalar.mulf %ys3, %sign : f32
 %xc3 = scalar.mulf %nf3, %c3 : f32
 %result3 = scalar.addf %xc3, %rotated3 : f32
 %rounded3 = scalar.fptrunc %result3 : f32 to bf16
 view.store %rounded3, %outv[%i3] : bf16, view<[%size]xbf16>
 }
 kernel.return
}
