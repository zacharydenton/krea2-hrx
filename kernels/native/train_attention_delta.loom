amdgpu.target<gfx11-generic> @krea2_train_attention_delta_target {subgroup_size = 32}
config.decl @krea2.train_attention_delta.tokens : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_attention_delta.heads : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_attention_delta.kv : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_attention_delta.qsize : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_attention_delta.ksize : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_attention_delta.stats : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_attention_delta.grid_x : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_attention_delta.grid_y : %value: index where [range(%value, 1, 1073741824)]
kernel.def target(@krea2_train_attention_delta_target) export("krea2_train_attention_delta") @krea2_train_attention_delta(%count: index) {
 %one = index.constant 1 : index
 %threads = index.constant 32 : index
 %gx = config.get @krea2.train_attention_delta.grid_x : index
 %gy = config.get @krea2.train_attention_delta.grid_y : index
 kernel.launch.config workgroups(%gx, %gy, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %grad: buffer, %exact: buffer, %delta: buffer) {
 %zero_offset = index.constant 0 : offset
 %lane = kernel.workitem.id<x> : index
 %group = kernel.workgroup.id<x> : index
 %zero = index.constant 0 : index
 %one = index.constant 1 : index
 %hsize = index.constant 128 : index
 %warp = scalar.constant 32 : i32
 %zf = scalar.constant 0.0 : f32
 %of = scalar.constant 1.0 : f32
 %scale = scalar.constant 0.08838834764831845 : f32

%tokens = config.get @krea2.train_attention_delta.tokens : index
%heads = config.get @krea2.train_attention_delta.heads : index
%kv = config.get @krea2.train_attention_delta.kv : index
%qsize = config.get @krea2.train_attention_delta.qsize : index
%ksize = config.get @krea2.train_attention_delta.ksize : index
%stats = config.get @krea2.train_attention_delta.stats : index
%repeat = index.div %heads, %kv : index
%gradg = buffer.assume.memory_space<global> %grad : buffer
%grad_view = buffer.view %gradg[%zero_offset] : buffer -> view<[%qsize]xbf16>
%exactg = buffer.assume.memory_space<global> %exact : buffer
%exact_view = buffer.view %exactg[%zero_offset] : buffer -> view<[%qsize]xf32>
%deltag = buffer.assume.memory_space<global> %delta : buffer
%delta_view = buffer.view %deltag[%zero_offset] : buffer -> view<[%stats]xf32>
%v1 = index.mul %group, %hsize : index
%v2 = index.constant 0 : index
%v3 = index.add %lane, %v2 : index
%v4 = index.add %v1, %v3 : index
%v5 = index.constant 32 : index
%v6 = index.add %lane, %v5 : index
%v7 = index.add %v1, %v6 : index
%v8 = index.constant 64 : index
%v9 = index.add %lane, %v8 : index
%v10 = index.add %v1, %v9 : index
%v11 = index.constant 96 : index
%v12 = index.add %lane, %v11 : index
%v13 = index.add %v1, %v12 : index
%v14 = index.assume %v4 [range(%v4, 0, 1073741824), lt(%v4, %qsize)] : index
%v15 = view.load %grad_view[%v14] : view<[%qsize]xbf16> -> bf16
%v16 = scalar.extf %v15 : bf16 to f32
%v17 = index.assume %v7 [range(%v7, 0, 1073741824), lt(%v7, %qsize)] : index
%v18 = view.load %grad_view[%v17] : view<[%qsize]xbf16> -> bf16
%v19 = scalar.extf %v18 : bf16 to f32
%v20 = index.assume %v10 [range(%v10, 0, 1073741824), lt(%v10, %qsize)] : index
%v21 = view.load %grad_view[%v20] : view<[%qsize]xbf16> -> bf16
%v22 = scalar.extf %v21 : bf16 to f32
%v23 = index.assume %v13 [range(%v13, 0, 1073741824), lt(%v13, %qsize)] : index
%v24 = view.load %grad_view[%v23] : view<[%qsize]xbf16> -> bf16
%v25 = scalar.extf %v24 : bf16 to f32
%v26 = index.assume %v4 [range(%v4, 0, 1073741824), lt(%v4, %qsize)] : index
%v27 = view.load %exact_view[%v26] : view<[%qsize]xf32> -> f32
%v28 = index.assume %v7 [range(%v7, 0, 1073741824), lt(%v7, %qsize)] : index
%v29 = view.load %exact_view[%v28] : view<[%qsize]xf32> -> f32
%v30 = index.assume %v10 [range(%v10, 0, 1073741824), lt(%v10, %qsize)] : index
%v31 = view.load %exact_view[%v30] : view<[%qsize]xf32> -> f32
%v32 = index.assume %v13 [range(%v13, 0, 1073741824), lt(%v13, %qsize)] : index
%v33 = view.load %exact_view[%v32] : view<[%qsize]xf32> -> f32
%v34 = scalar.mulf %v16, %v27 : f32
%v35 = scalar.addf %zf, %v34 : f32
%v36 = scalar.mulf %v19, %v29 : f32
%v37 = scalar.addf %v35, %v36 : f32
%v38 = scalar.mulf %v22, %v31 : f32
%v39 = scalar.addf %v37, %v38 : f32
%v40 = scalar.mulf %v25, %v33 : f32
%v41 = scalar.addf %v39, %v40 : f32
%v42 = scalar.constant 16 : i32
%peer43, %valid43 = kernel.subgroup.shuffle<xor> %v41, %v42, %warp : f32, i32, i32
%v44 = scalar.addf %v41, %peer43 : f32
%v45 = scalar.constant 8 : i32
%peer46, %valid46 = kernel.subgroup.shuffle<xor> %v44, %v45, %warp : f32, i32, i32
%v47 = scalar.addf %v44, %peer46 : f32
%v48 = scalar.constant 4 : i32
%peer49, %valid49 = kernel.subgroup.shuffle<xor> %v47, %v48, %warp : f32, i32, i32
%v50 = scalar.addf %v47, %peer49 : f32
%v51 = scalar.constant 2 : i32
%peer52, %valid52 = kernel.subgroup.shuffle<xor> %v50, %v51, %warp : f32, i32, i32
%v53 = scalar.addf %v50, %peer52 : f32
%v54 = scalar.constant 1 : i32
%peer55, %valid55 = kernel.subgroup.shuffle<xor> %v53, %v54, %warp : f32, i32, i32
%v56 = scalar.addf %v53, %peer55 : f32
%v57 = index.cmp eq, %lane, %zero : index
scf.if %v57 {
%v58 = index.assume %group [range(%group, 0, 1073741824), lt(%group, %stats)] : index
view.store %v56, %delta_view[%v58] : f32, view<[%stats]xf32>
}
kernel.return
}
