amdgpu.target<gfx11-generic> @target {subgroup_size = 32}
config.decl @krea2.train_full_adamw.grid_x : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_full_adamw.grid_y : %value: index where [range(%value, 1, 1073741824)]
config.decl @krea2.train_full_adamw.parts : %value: index where [range(%value, 1, 1073741824)]
kernel.def target(@target) export("krea2_train_full_adamw") @krea2_train_full_adamw(%count: index) {
 %one = index.constant 1 : index
 %threads = index.constant 32 : index
 %gx = config.get @krea2.train_full_adamw.grid_x : index
 %gy = config.get @krea2.train_full_adamw.grid_y : index
 kernel.launch.config workgroups(%gx, %gy, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %key0: index, %key1: index, %controls: buffer, %weight: buffer, %grad: buffer, %first: buffer, %second: buffer, %scales: buffer, %maps: buffer, %clock: buffer) {
 %offset = index.constant 0 : offset
 %zero = index.constant 0 : index
 %one = index.constant 1 : index
 %two = index.constant 2 : index
 %c256 = index.constant 256 : index
 %c32 = index.constant 32 : index
 %n = index.assume %count [range(%count, 1, 1073741824)] : index
 %parts = config.get @krea2.train_full_adamw.parts : index
 %lane = kernel.workitem.id<x> : index
 %group = kernel.workgroup.id<x> : index
 %part = index.assume %group [range(%group, 0, 1073741824), lt(%group, %parts)] : index
 %base = index.mul %part, %c256 : index
 %zero_f = scalar.constant 0.0 : f32
 %one_f = scalar.constant 1.0 : f32
 %controls_g = buffer.assume.memory_space<global> %controls : buffer
 %cv = buffer.view %controls_g[%offset] : buffer -> view<8xf32>
 %weight_g = buffer.assume.memory_space<global> %weight : buffer
 %wv = buffer.view %weight_g[%offset] : buffer -> view<[%n]xbf16>
 %grad_g = buffer.assume.memory_space<global> %grad : buffer
 %gv = buffer.view %grad_g[%offset] : buffer -> view<[%n]xbf16>
 %first_g = buffer.assume.memory_space<global> %first : buffer
 %mv = buffer.view %first_g[%offset] : buffer -> view<[%n]xi8>
 %second_g = buffer.assume.memory_space<global> %second : buffer
 %vv = buffer.view %second_g[%offset] : buffer -> view<[%n]xi8>
 %scales_g = buffer.assume.memory_space<global> %scales : buffer
 %sv = buffer.view %scales_g[%offset] : buffer -> view<2x[%parts]xf32>
 %maps_g = buffer.assume.memory_space<global> %maps : buffer
 %qv = buffer.view %maps_g[%offset] : buffer -> view<2x256xf32>
 %cc0 = index.constant 0 : index
 %lr = view.load %cv[%cc0] : view<8xf32> -> f32
 %cc1 = index.constant 1 : index
 %decay = view.load %cv[%cc1] : view<8xf32> -> f32
 %cc2 = index.constant 2 : index
 %beta1 = view.load %cv[%cc2] : view<8xf32> -> f32
 %cc3 = index.constant 3 : index
 %beta2 = view.load %cv[%cc3] : view<8xf32> -> f32
 %cc4 = index.constant 4 : index
 %eps = view.load %cv[%cc4] : view<8xf32> -> f32
 %cc5 = index.constant 5 : index
 %gscale = view.load %cv[%cc5] : view<8xf32> -> f32
 %cc6 = index.constant 6 : index
 %bias1 = view.load %cv[%cc6] : view<8xf32> -> f32
 %cc7 = index.constant 7 : index
 %bias2 = view.load %cv[%cc7] : view<8xf32> -> f32
 %old_ms = view.load %sv[%zero, %part] : view<2x[%parts]xf32> -> f32
 %old_vs = view.load %sv[%one, %part] : view<2x[%parts]xf32> -> f32
 %b1c = scalar.subf %one_f, %beta1 : f32
 %b2c = scalar.subf %one_f, %beta2 : f32
 %bytes = index.constant 2048 : offset
 %voffset = index.constant 1024 : offset
 %lds = buffer.alloca<workgroup> align(16) %bytes : buffer
 %lm = buffer.view %lds[%offset] : buffer -> view<256xf32>
 %lv = buffer.view %lds[%voffset] : buffer -> view<256xf32>
 %mmax, %vmax = scf.for %j = [%lane to %c256 step %c32](%max_m = %zero_f, %max_v = %zero_f : f32, f32) -> (f32, f32) {
  %idx = index.add %base, %j : index
  %ok = index.cmp ult, %idx, %n : index
  %nm, %nv = scf.if %ok -> (f32, f32) {
   %i = index.assume %idx [range(%idx, 0, 1073741824), lt(%idx, %n)] : index
   %mc = view.load %mv[%i] : view<[%n]xi8> -> i8
   %vc = view.load %vv[%i] : view<[%n]xi8> -> i8
   %mi = scalar.extui %mc : i8 to i32
   %vi = scalar.extui %vc : i8 to i32
   %mix = index.cast %mi : i32 to index
   %vix = index.cast %vi : i32 to index
   %mic = index.assume %mix [range(%mix, 0, 256)] : index
   %vic = index.assume %vix [range(%vix, 0, 256)] : index
   %qm = view.load %qv[%zero, %mic] : view<2x256xf32> -> f32
   %qvv = view.load %qv[%one, %vic] : view<2x256xf32> -> f32
   %m0 = scalar.mulf %qm, %old_ms : f32
   %v0 = scalar.mulf %qvv, %old_vs : f32
   %gb = view.load %gv[%i] : view<[%n]xbf16> -> bf16
   %g0 = scalar.extf %gb : bf16 to f32
   %g = scalar.mulf %g0, %gscale : f32
   %old_m = scalar.mulf %m0, %beta1 : f32
   %add_m = scalar.mulf %g, %b1c : f32
   %m = scalar.addf %old_m, %add_m : f32
   %old_v = scalar.mulf %v0, %beta2 : f32
   %square = scalar.mulf %g, %g : f32
   %add_v = scalar.mulf %square, %b2c : f32
   %v = scalar.addf %old_v, %add_v : f32
   scf.yield %m, %v : f32, f32
  } else { scf.yield %zero_f, %zero_f : f32, f32 }
  %li = index.assume %j [range(%j, 0, 256)] : index
  view.store %nm, %lm[%li] : f32, view<256xf32>
  view.store %nv, %lv[%li] : f32, view<256xf32>
  %abs_m = scalar.absf %nm : f32
  %next_m = scalar.maximumf %max_m, %abs_m : f32
  %next_v = scalar.maximumf %max_v, %nv : f32
  scf.yield %next_m, %next_v : f32, f32
 }
 %warp = scalar.constant 32 : i32
 %off16 = scalar.constant 16 : i32
 %mp16, %mb16 = kernel.subgroup.shuffle<xor> %mmax, %off16, %warp : f32, i32, i32
 %vp16, %vb16 = kernel.subgroup.shuffle<xor> %vmax, %off16, %warp : f32, i32, i32
 %mm16 = scalar.maximumf %mmax, %mp16 : f32
 %vm16 = scalar.maximumf %vmax, %vp16 : f32
