   %root_u0 = scalar.sqrtf %vh_u0 : f32
   %denom_u0 = scalar.addf %root_u0, %eps : f32
   %direction_u0 = scalar.divf %mh_u0, %denom_u0 : f32
   %update_u0 = scalar.mulf %lr, %direction_u0 : f32
   %ld_u0 = scalar.mulf %lr, %decay : f32
   %retain_u0 = scalar.subf %one_f, %ld_u0 : f32
   %wb_u0 = view.load %wv[%i2_u0] : view<[%n]xbf16> -> bf16
   %w_u0 = scalar.extf %wb_u0 : bf16 to f32
   %retained_u0 = scalar.mulf %w_u0, %retain_u0 : f32
   %next_u0 = scalar.subf %retained_u0, %update_u0 : f32
   %rounded_u0 = func.call @full_sr(%next_u0, %i2_u0, %key0, %key1, %clock) : (f32, index, index, index, buffer) -> (bf16)
   %mcode_u0 = func.call @full_quantize(%mn_u0, %mm1, %maps, %zero) : (f32, f32, buffer, index) -> (i8)
