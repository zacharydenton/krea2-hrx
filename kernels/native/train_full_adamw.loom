 %vm2 = scalar.maximumf %vm4, %vp2 : f32
 %off1 = scalar.constant 1 : i32
 %mp1, %mb1 = kernel.subgroup.shuffle<xor> %mm2, %off1, %warp : f32, i32, i32
 %vp1, %vb1 = kernel.subgroup.shuffle<xor> %vm2, %off1, %warp : f32, i32, i32
 %mm1 = scalar.maximumf %mm2, %mp1 : f32
 %vm1 = scalar.maximumf %vm2, %vp1 : f32
