 %first_lane = index.cmp eq, %lane, %zero : index
 scf.if %first_lane {
  view.store %mm1, %sv[%zero, %part] : f32, view<2x[%parts]xf32>
  view.store %vm1, %sv[%one, %part] : f32, view<2x[%parts]xf32>
 }
 %j2base_u0 = index.constant 0 : index

  %j2_u0 = index.add %j2base_u0, %lane : index
