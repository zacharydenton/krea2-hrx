   %li2_u0 = index.assume %j2_u0 [range(%j2_u0, 0, 256)] : index
   %mn_u0 = view.load %lm[%li2_u0] : view<256xf32> -> f32
   %vn_u0 = view.load %lv[%li2_u0] : view<256xf32> -> f32
   %mh_u0 = scalar.divf %mn_u0, %bias1 : f32
