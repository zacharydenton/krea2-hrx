func.def inline @full_quantize(%value: f32, %maximum: f32, %maps: buffer, %row: index) -> (i8) {
 %offset = index.constant 0 : offset
 %qg = buffer.assume.memory_space<global> %maps : buffer
 %qv = buffer.view %qg[%offset] : buffer -> view<2x256xf32>
 %qr = index.assume %row [range(%row, 0, 2)] : index
 %zero = index.constant 0 : index
 %one = index.constant 1 : index
 %two = index.constant 2 : index
 %nine = index.constant 9 : index
 %c255 = index.constant 255 : index
 %c256 = index.constant 256 : index
 %zf = scalar.constant 0.0 : f32
 %of = scalar.constant 1.0 : f32
 %iszero = scalar.cmpf oeq, %maximum, %zf : f32
 %divisor = scf.select %iszero, %of, %maximum : f32
 %x = scalar.divf %value, %divisor : f32
  %lb_q0 = index.assume %zero [range(%zero, 0, 257)] : index
  %hb_q0 = index.assume %c256 [range(%c256, 0, 257)] : index
  %sum_q0 = index.add %lb_q0, %hb_q0 : index
  %mid0_q0 = index.div %sum_q0, %two : index
  %inside_q0 = index.cmp ult, %mid0_q0, %c256 : index
  %mid1_q0 = scf.select %inside_q0, %mid0_q0, %c255 : index
  %mid_q0 = index.assume %mid1_q0 [range(%mid1_q0, 0, 256)] : index
  %v_q0 = view.load %qv[%qr, %mid_q0] : view<2x256xf32> -> f32
  %less_q0 = scalar.cmpf olt, %v_q0, %x : f32
  %next_q0 = index.add %mid_q0, %one : index
  %nl_q0 = scf.select %less_q0, %next_q0, %zero : index
  %nh_q0 = scf.select %less_q0, %c256, %mid_q0 : index
  %lb_q1 = index.assume %nl_q0 [range(%nl_q0, 0, 257)] : index
  %hb_q1 = index.assume %nh_q0 [range(%nh_q0, 0, 257)] : index
  %sum_q1 = index.add %lb_q1, %hb_q1 : index
  %mid0_q1 = index.div %sum_q1, %two : index
  %inside_q1 = index.cmp ult, %mid0_q1, %c256 : index
  %mid1_q1 = scf.select %inside_q1, %mid0_q1, %c255 : index
  %mid_q1 = index.assume %mid1_q1 [range(%mid1_q1, 0, 256)] : index
  %v_q1 = view.load %qv[%qr, %mid_q1] : view<2x256xf32> -> f32
  %less_q1 = scalar.cmpf olt, %v_q1, %x : f32
  %next_q1 = index.add %mid_q1, %one : index
  %nl_q1 = scf.select %less_q1, %next_q1, %nl_q0 : index
  %nh_q1 = scf.select %less_q1, %nh_q0, %mid_q1 : index
  %lb_q2 = index.assume %nl_q1 [range(%nl_q1, 0, 257)] : index
  %hb_q2 = index.assume %nh_q1 [range(%nh_q1, 0, 257)] : index
  %sum_q2 = index.add %lb_q2, %hb_q2 : index
  %mid0_q2 = index.div %sum_q2, %two : index
  %inside_q2 = index.cmp ult, %mid0_q2, %c256 : index
  %mid1_q2 = scf.select %inside_q2, %mid0_q2, %c255 : index
  %mid_q2 = index.assume %mid1_q2 [range(%mid1_q2, 0, 256)] : index
  %v_q2 = view.load %qv[%qr, %mid_q2] : view<2x256xf32> -> f32
  %less_q2 = scalar.cmpf olt, %v_q2, %x : f32
  %next_q2 = index.add %mid_q2, %one : index
  %nl_q2 = scf.select %less_q2, %next_q2, %nl_q1 : index
  %nh_q2 = scf.select %less_q2, %nh_q1, %mid_q2 : index
  %lb_q3 = index.assume %nl_q2 [range(%nl_q2, 0, 257)] : index
  %hb_q3 = index.assume %nh_q2 [range(%nh_q2, 0, 257)] : index
  %sum_q3 = index.add %lb_q3, %hb_q3 : index
  %mid0_q3 = index.div %sum_q3, %two : index
  %inside_q3 = index.cmp ult, %mid0_q3, %c256 : index
  %mid1_q3 = scf.select %inside_q3, %mid0_q3, %c255 : index
  %mid_q3 = index.assume %mid1_q3 [range(%mid1_q3, 0, 256)] : index
  %v_q3 = view.load %qv[%qr, %mid_q3] : view<2x256xf32> -> f32
  %less_q3 = scalar.cmpf olt, %v_q3, %x : f32
  %next_q3 = index.add %mid_q3, %one : index
  %nl_q3 = scf.select %less_q3, %next_q3, %nl_q2 : index
  %nh_q3 = scf.select %less_q3, %nh_q2, %mid_q3 : index
  %lb_q4 = index.assume %nl_q3 [range(%nl_q3, 0, 257)] : index
  %hb_q4 = index.assume %nh_q3 [range(%nh_q3, 0, 257)] : index
  %sum_q4 = index.add %lb_q4, %hb_q4 : index
  %mid0_q4 = index.div %sum_q4, %two : index
  %inside_q4 = index.cmp ult, %mid0_q4, %c256 : index
  %mid1_q4 = scf.select %inside_q4, %mid0_q4, %c255 : index
  %mid_q4 = index.assume %mid1_q4 [range(%mid1_q4, 0, 256)] : index
  %v_q4 = view.load %qv[%qr, %mid_q4] : view<2x256xf32> -> f32
  %less_q4 = scalar.cmpf olt, %v_q4, %x : f32
  %next_q4 = index.add %mid_q4, %one : index
  %nl_q4 = scf.select %less_q4, %next_q4, %nl_q3 : index
  %nh_q4 = scf.select %less_q4, %nh_q3, %mid_q4 : index
  %lb_q5 = index.assume %nl_q4 [range(%nl_q4, 0, 257)] : index
  %hb_q5 = index.assume %nh_q4 [range(%nh_q4, 0, 257)] : index
  %sum_q5 = index.add %lb_q5, %hb_q5 : index
  %mid0_q5 = index.div %sum_q5, %two : index
  %inside_q5 = index.cmp ult, %mid0_q5, %c256 : index
  %mid1_q5 = scf.select %inside_q5, %mid0_q5, %c255 : index
  %mid_q5 = index.assume %mid1_q5 [range(%mid1_q5, 0, 256)] : index
  %v_q5 = view.load %qv[%qr, %mid_q5] : view<2x256xf32> -> f32
  %less_q5 = scalar.cmpf olt, %v_q5, %x : f32
  %next_q5 = index.add %mid_q5, %one : index
  %nl_q5 = scf.select %less_q5, %next_q5, %nl_q4 : index
  %nh_q5 = scf.select %less_q5, %nh_q4, %mid_q5 : index
  %lb_q6 = index.assume %nl_q5 [range(%nl_q5, 0, 257)] : index
  %hb_q6 = index.assume %nh_q5 [range(%nh_q5, 0, 257)] : index
  %sum_q6 = index.add %lb_q6, %hb_q6 : index
  %mid0_q6 = index.div %sum_q6, %two : index
  %inside_q6 = index.cmp ult, %mid0_q6, %c256 : index
  %mid1_q6 = scf.select %inside_q6, %mid0_q6, %c255 : index
  %mid_q6 = index.assume %mid1_q6 [range(%mid1_q6, 0, 256)] : index
  %v_q6 = view.load %qv[%qr, %mid_q6] : view<2x256xf32> -> f32
  %less_q6 = scalar.cmpf olt, %v_q6, %x : f32
  %next_q6 = index.add %mid_q6, %one : index
  %nl_q6 = scf.select %less_q6, %next_q6, %nl_q5 : index
  %nh_q6 = scf.select %less_q6, %nh_q5, %mid_q6 : index
  %lb_q7 = index.assume %nl_q6 [range(%nl_q6, 0, 257)] : index
  %hb_q7 = index.assume %nh_q6 [range(%nh_q6, 0, 257)] : index
  %sum_q7 = index.add %lb_q7, %hb_q7 : index
  %mid0_q7 = index.div %sum_q7, %two : index
  %inside_q7 = index.cmp ult, %mid0_q7, %c256 : index
  %mid1_q7 = scf.select %inside_q7, %mid0_q7, %c255 : index
  %mid_q7 = index.assume %mid1_q7 [range(%mid1_q7, 0, 256)] : index
  %v_q7 = view.load %qv[%qr, %mid_q7] : view<2x256xf32> -> f32
  %less_q7 = scalar.cmpf olt, %v_q7, %x : f32
  %next_q7 = index.add %mid_q7, %one : index
  %nl_q7 = scf.select %less_q7, %next_q7, %nl_q6 : index
  %nh_q7 = scf.select %less_q7, %nh_q6, %mid_q7 : index
  %lb_q8 = index.assume %nl_q7 [range(%nl_q7, 0, 257)] : index
  %hb_q8 = index.assume %nh_q7 [range(%nh_q7, 0, 257)] : index
  %sum_q8 = index.add %lb_q8, %hb_q8 : index
  %mid0_q8 = index.div %sum_q8, %two : index
  %inside_q8 = index.cmp ult, %mid0_q8, %c256 : index
  %mid1_q8 = scf.select %inside_q8, %mid0_q8, %c255 : index
  %mid_q8 = index.assume %mid1_q8 [range(%mid1_q8, 0, 256)] : index
  %v_q8 = view.load %qv[%qr, %mid_q8] : view<2x256xf32> -> f32
  %less_q8 = scalar.cmpf olt, %v_q8, %x : f32
  %next_q8 = index.add %mid_q8, %one : index
  %nl_q8 = scf.select %less_q8, %next_q8, %nl_q7 : index
  %nh_q8 = scf.select %less_q8, %nh_q7, %mid_q8 : index

 %valid = index.cmp ult, %nl_q8, %c256 : index
 %upper0 = scf.select %valid, %nl_q8, %c255 : index
 %upper = index.assume %upper0 [range(%upper0, 0, 256)] : index
 %haslower = index.cmp ugt, %upper, %zero : index
 %sub = index.sub %upper, %one : index
 %lower0 = scf.select %haslower, %sub, %zero : index
 %lower = index.assume %lower0 [range(%lower0, 0, 256)] : index
 %a = view.load %qv[%qr, %lower] : view<2x256xf32> -> f32
 %b = view.load %qv[%qr, %upper] : view<2x256xf32> -> f32
 %da = scalar.subf %x, %a : f32
 %db = scalar.subf %b, %x : f32
 %aa = scalar.absf %da : f32
 %ab = scalar.absf %db : f32
 %choose = scalar.cmpf ole, %aa, %ab : f32
 %result = scf.select %choose, %lower, %upper : index
 %int = index.cast %result : index to i32
 %byte = scalar.trunci %int : i32 to i8
 func.return %byte : i8
}
