amdgpu.target<gfx11-generic> @krea2_head_pack_target {subgroup_size = 32}

config.decl @krea2.head_pack.dim : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.head_pack.tokens : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.head_pack.heads : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.head_pack.kv : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.head_pack.xsize : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.head_pack.ysize : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.head_pack.grid_x : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.head_pack.grid_y : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@krea2_head_pack_target) export("krea2_head_pack") @krea2_head_pack(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %grid_x = config.get @krea2.head_pack.grid_x : index
  %grid_y = config.get @krea2.head_pack.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %x: buffer, %y: buffer) {
  %v1 = index.constant 256 : index
  %zero_offset = index.constant 0 : offset
  %count_b = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %dim = config.get @krea2.head_pack.dim : index
  %tokens = config.get @krea2.head_pack.tokens : index
  %heads = config.get @krea2.head_pack.heads : index
  %kv = config.get @krea2.head_pack.kv : index
  %xsize = config.get @krea2.head_pack.xsize : index
  %ysize = config.get @krea2.head_pack.ysize : index
  %v2 = index.mul %group, %v1 : index
  %v3 = index.add %v2, %lane : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %x_view = buffer.view %x_global[%zero_offset] : buffer -> view<[%xsize]xbf16>
  %y_global = buffer.assume.memory_space<global> %y : buffer
  %y_view = buffer.view %y_global[%zero_offset] : buffer -> view<[%ysize]xbf16>
  %v4 = index.cmp ult, %v3, %count_b : index
  scf.if %v4 {
    %v5 = index.rem %v3, %dim : index
    %v6 = index.div %v3, %dim : index
    %v7 = index.rem %v6, %tokens : index
    %v8 = index.div %v3, %dim : index
    %v9 = index.div %v8, %tokens : index
    %v10 = index.rem %v9, %heads : index
    %v11 = index.div %v3, %dim : index
    %v12 = index.div %v11, %tokens : index
    %v13 = index.div %v12, %heads : index
    %v14 = index.mul %v13, %tokens : index
    %v15 = index.add %v14, %v7 : index
    %v16 = index.mul %v15, %kv : index
    %v17 = index.div %heads, %kv : index
    %v18 = index.div %v10, %v17 : index
    %v19 = index.add %v16, %v18 : index
    %v20 = index.mul %v19, %dim : index
    %v21 = index.add %v20, %v5 : index
    %v22 = index.assume %v21 [range(%v21, 0, 1073741824), lt(%v21, %xsize)] : index
    %v23 = view.load %x_view[%v22] : view<[%xsize]xbf16> -> bf16
    %v24 = scalar.extf %v23 : bf16 to f32
    %v25 = scalar.fptrunc %v24 : f32 to bf16
    %v26 = index.assume %v3 [range(%v3, 0, 1073741824), lt(%v3, %ysize)] : index
    view.store %v25, %y_view[%v26] : bf16, view<[%ysize]xbf16>
  }
  kernel.return
}
