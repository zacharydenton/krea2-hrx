amdgpu.target<gfx11-generic> @krea2_columns_target {subgroup_size = 32}

config.decl @krea2.columns.xsize : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.columns.cols : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.columns.width : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.columns.start1 : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.columns.grid_x : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.columns.grid_y : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@krea2_columns_target) export("krea2_columns") @krea2_columns(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %grid_x = config.get @krea2.columns.grid_x : index
  %grid_y = config.get @krea2.columns.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %x: buffer, %y: buffer) {
  %v1 = index.constant 256 : index
  %v8 = index.constant 1 : index
  %zero_offset = index.constant 0 : offset
  %count_b = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %xsize = config.get @krea2.columns.xsize : index
  %cols = config.get @krea2.columns.cols : index
  %width = config.get @krea2.columns.width : index
  %start1 = config.get @krea2.columns.start1 : index
  %v2 = index.mul %group, %v1 : index
  %v3 = index.add %v2, %lane : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %x_view = buffer.view %x_global[%zero_offset] : buffer -> view<[%xsize]xbf16>
  %y_global = buffer.assume.memory_space<global> %y : buffer
  %y_view = buffer.view %y_global[%zero_offset] : buffer -> view<[%count_b]xbf16>
  %v4 = index.cmp ult, %v3, %count_b : index
  scf.if %v4 {
    %v5 = index.div %v3, %cols : index
    %v6 = index.mul %v5, %width : index
    %v7 = index.rem %v3, %cols : index
    %v9 = index.sub %start1, %v8 : index
    %v10 = index.add %v7, %v9 : index
    %v11 = index.add %v6, %v10 : index
    %v12 = index.assume %v11 [range(%v11, 0, 1073741824), lt(%v11, %xsize)] : index
    %v13 = view.load %x_view[%v12] : view<[%xsize]xbf16> -> bf16
    %v14 = scalar.extf %v13 : bf16 to f32
    %v15 = scalar.fptrunc %v14 : f32 to bf16
    %v16 = index.assume %v3 [range(%v3, 0, 1073741824), lt(%v3, %count_b)] : index
    view.store %v15, %y_view[%v16] : bf16, view<[%count_b]xbf16>
  }
  kernel.return
}
