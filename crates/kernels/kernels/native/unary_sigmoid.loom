amdgpu.target<gfx11-generic> @krea2_unary_sigmoid_target {subgroup_size = 32}

config.decl @krea2.unary_sigmoid.grid_x : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.unary_sigmoid.grid_y : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@krea2_unary_sigmoid_target) export("krea2_unary_sigmoid") @krea2_unary_sigmoid(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %grid_x = config.get @krea2.unary_sigmoid.grid_x : index
  %grid_y = config.get @krea2.unary_sigmoid.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %x: buffer, %y: buffer) {
  %v1 = index.constant 256 : index
  %v8 = scalar.constant 1.0 : f32
  %zero_offset = index.constant 0 : offset
  %count_b = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %v2 = index.mul %group, %v1 : index
  %v3 = index.add %v2, %lane : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %x_view = buffer.view %x_global[%zero_offset] : buffer -> view<[%count_b]xbf16>
  %y_global = buffer.assume.memory_space<global> %y : buffer
  %y_view = buffer.view %y_global[%zero_offset] : buffer -> view<[%count_b]xbf16>
  %v4 = index.cmp ult, %v3, %count_b : index
  scf.if %v4 {
    %v5 = index.assume %v3 [range(%v3, 0, 1073741824), lt(%v3, %count_b)] : index
    %v6 = view.load %x_view[%v5] : view<[%count_b]xbf16> -> bf16
    %v7 = scalar.extf %v6 : bf16 to f32
    %v9 = scalar.negf %v7 : f32
    %v10 = scalar.expf<afn> %v9 : f32
    %v11 = scalar.addf %v8, %v10 : f32
    %v12 = scalar.divf %v8, %v11 : f32
    %v13 = scalar.fptrunc %v12 : f32 to bf16
    %v14 = index.assume %v3 [range(%v3, 0, 1073741824), lt(%v3, %count_b)] : index
    view.store %v13, %y_view[%v14] : bf16, view<[%count_b]xbf16>
  }
  kernel.return
}
