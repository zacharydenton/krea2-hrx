amdgpu.target<gfx11-generic> @krea2_binary_mul_target {subgroup_size = 32}

config.decl @krea2.binary_mul.yn : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.binary_mul.grid_x : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.binary_mul.grid_y : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@krea2_binary_mul_target) export("krea2_binary_mul") @krea2_binary_mul(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %grid_x = config.get @krea2.binary_mul.grid_x : index
  %grid_y = config.get @krea2.binary_mul.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %x: buffer, %y: buffer, %z: buffer) {
  %v1 = index.constant 256 : index
  %zero_offset = index.constant 0 : offset
  %count_b = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %yn = config.get @krea2.binary_mul.yn : index
  %v2 = index.mul %group, %v1 : index
  %v3 = index.add %v2, %lane : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %x_view = buffer.view %x_global[%zero_offset] : buffer -> view<[%count_b]xbf16>
  %y_global = buffer.assume.memory_space<global> %y : buffer
  %y_view = buffer.view %y_global[%zero_offset] : buffer -> view<[%yn]xbf16>
  %z_global = buffer.assume.memory_space<global> %z : buffer
  %z_view = buffer.view %z_global[%zero_offset] : buffer -> view<[%count_b]xbf16>
  %v4 = index.cmp ult, %v3, %count_b : index
  scf.if %v4 {
    %v5 = index.assume %v3 [range(%v3, 0, 1073741824), lt(%v3, %count_b)] : index
    %v6 = view.load %x_view[%v5] : view<[%count_b]xbf16> -> bf16
    %v7 = scalar.extf %v6 : bf16 to f32
    %v8 = index.rem %v3, %yn : index
    %v9 = index.assume %v8 [range(%v8, 0, 1073741824), lt(%v8, %yn)] : index
    %v10 = view.load %y_view[%v9] : view<[%yn]xbf16> -> bf16
    %v11 = scalar.extf %v10 : bf16 to f32
    %v12 = scalar.mulf %v7, %v11 : f32
    %v13 = scalar.fptrunc %v12 : f32 to bf16
    %v14 = index.assume %v3 [range(%v3, 0, 1073741824), lt(%v3, %count_b)] : index
    view.store %v13, %z_view[%v14] : bf16, view<[%count_b]xbf16>
  }
  kernel.return
}
