amdgpu.target<gfx11-generic> @krea2_sage_query_mean_target {subgroup_size = 32}

config.decl @krea2.sage_query_mean.tokens : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.sage_query_mean.heads : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.sage_query_mean.tiles : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.sage_query_mean.xsize : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.sage_query_mean.ysize : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.sage_query_mean.grid_x : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.sage_query_mean.grid_y : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@krea2_sage_query_mean_target) export("krea2_sage_query_mean") @krea2_sage_query_mean(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 128 : index
  %grid_x = config.get @krea2.sage_query_mean.grid_x : index
  %grid_y = config.get @krea2.sage_query_mean.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %x: buffer, %y: buffer, %half: buffer) {
  %v1 = index.constant 128 : index
  %v4 = index.constant 64 : index
  %v15 = index.constant 1 : index
  %v16 = scalar.constant 0.0 : f32
  %zero_offset = index.constant 0 : offset
  %count_b = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %tokens = config.get @krea2.sage_query_mean.tokens : index
  %heads = config.get @krea2.sage_query_mean.heads : index
  %tiles = config.get @krea2.sage_query_mean.tiles : index
  %xsize = config.get @krea2.sage_query_mean.xsize : index
  %ysize = config.get @krea2.sage_query_mean.ysize : index
  %v2 = index.mul %group, %v1 : index
  %v3 = index.add %v2, %lane : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %x_view = buffer.view %x_global[%zero_offset] : buffer -> view<[%xsize]xf16>
  %y_global = buffer.assume.memory_space<global> %y : buffer
  %y_view = buffer.view %y_global[%zero_offset] : buffer -> view<[%ysize]xf32>
  %half_global = buffer.assume.memory_space<global> %half : buffer
  %half_view = buffer.view %half_global[%zero_offset] : buffer -> view<[%ysize]xf16>
  %v5 = index.mul %group, %v4 : index
  %v6 = index.add %v5, %v4 : index
  %v7 = index.min %v6, %tokens : index
  %v8 = index.sub %v7, %v5 : index
  %v9 = index.cast %v8 : index to i32
  %v10 = scalar.sitofp %v9 : i32 to f32
  %v11 = index.mul %group_y, %tiles : index
  %v12 = index.add %v11, %group : index
  %v13 = index.mul %v12, %v1 : index
  %v14 = index.add %v13, %lane : index
  %v19 = scf.for %v17 = [%v5 to %v7 step %v15](%v18 = %v16 : f32) -> (f32) {
    %v20 = index.mul %v17, %heads : index
    %v21 = index.add %v20, %group_y : index
    %v22 = index.mul %v21, %v1 : index
    %v23 = index.add %v22, %lane : index
    %v24 = index.assume %v23 [range(%v23, 0, 1073741824), lt(%v23, %xsize)] : index
    %v25 = view.load %x_view[%v24] : view<[%xsize]xf16> -> f16
    %v26 = scalar.extf %v25 : f16 to f32
    %v27 = scalar.addf %v18, %v26 : f32
    scf.yield %v27 : f32
  }
  %v28 = scalar.divf %v19, %v10 : f32
  %v29 = index.assume %v14 [range(%v14, 0, 1073741824), lt(%v14, %ysize)] : index
  view.store %v28, %y_view[%v29] : f32, view<[%ysize]xf32>
  %v30 = scalar.fptrunc %v28 : f32 to f16
  %v31 = index.assume %v14 [range(%v14, 0, 1073741824), lt(%v14, %ysize)] : index
  view.store %v30, %half_view[%v31] : f16, view<[%ysize]xf16>
  kernel.return
}
