amdgpu.target<gfx11-generic> @krea2_upsample_target {subgroup_size = 32}

config.decl @krea2.upsample.xsize : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.upsample.channels : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.upsample.width : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.upsample.grid_x : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.upsample.grid_y : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@krea2_upsample_target) export("krea2_upsample") @krea2_upsample(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %grid_x = config.get @krea2.upsample.grid_x : index
  %grid_y = config.get @krea2.upsample.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %x: buffer, %y: buffer) {
  %v1 = index.constant 256 : index
  %v6 = index.constant 2 : index
  %zero_offset = index.constant 0 : offset
  %count_b = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %xsize = config.get @krea2.upsample.xsize : index
  %channels = config.get @krea2.upsample.channels : index
  %width = config.get @krea2.upsample.width : index
  %v2 = index.mul %group, %v1 : index
  %v3 = index.add %v2, %lane : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %x_view = buffer.view %x_global[%zero_offset] : buffer -> view<[%xsize]xbf16>
  %y_global = buffer.assume.memory_space<global> %y : buffer
  %y_view = buffer.view %y_global[%zero_offset] : buffer -> view<[%count_b]xbf16>
  %v4 = index.cmp ult, %v3, %count_b : index
  scf.if %v4 {
    %v5 = index.div %v3, %channels : index
    %v7 = index.mul %width, %v6 : index
    %v8 = index.div %v5, %v7 : index
    %v9 = index.div %v8, %v6 : index
    %v10 = index.mul %v9, %width : index
    %v11 = index.rem %v5, %v7 : index
    %v12 = index.div %v11, %v6 : index
    %v13 = index.add %v10, %v12 : index
    %v14 = index.mul %v13, %channels : index
    %v15 = index.rem %v3, %channels : index
    %v16 = index.add %v14, %v15 : index
    %v17 = index.assume %v16 [range(%v16, 0, 1073741824), lt(%v16, %xsize)] : index
    %v18 = view.load %x_view[%v17] : view<[%xsize]xbf16> -> bf16
    %v19 = scalar.extf %v18 : bf16 to f32
    %v20 = scalar.fptrunc %v19 : f32 to bf16
    %v21 = index.assume %v3 [range(%v3, 0, 1073741824), lt(%v3, %count_b)] : index
    view.store %v20, %y_view[%v21] : bf16, view<[%count_b]xbf16>
  }
  kernel.return
}
