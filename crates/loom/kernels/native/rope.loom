amdgpu.target<gfx11-generic> @krea2_rope_target {subgroup_size = 32}

config.decl @krea2.rope.dim : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.rope.heads : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.rope.grid_x : %value: index where [range(%value, 1, 1073741824)]

config.decl @krea2.rope.grid_y : %value: index where [range(%value, 1, 1073741824)]

kernel.def target(@krea2_rope_target) export("krea2_rope") @krea2_rope(%count: index) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %grid_x = config.get @krea2.rope.grid_x : index
  %grid_y = config.get @krea2.rope.grid_y : index
  kernel.launch.config workgroups(%grid_x, %grid_y, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count: index, %theta: f32, %x: buffer, %y: buffer) {
  %v1 = index.constant 256 : index
  %v6 = index.constant 2 : index
  %v14 = scalar.constant -2.0 : f32
  %v32 = scalar.constant -1.0 : f32
  %v33 = scalar.constant 1.0 : f32
  %zero_offset = index.constant 0 : offset
  %count_b = index.assume %count [range(%count, 1, 1073741824)] : index
  %lane = kernel.workitem.id<x> : index
  %group = kernel.workgroup.id<x> : index
  %group_y = kernel.workgroup.id<y> : index
  %dim = config.get @krea2.rope.dim : index
  %heads = config.get @krea2.rope.heads : index
  %v2 = index.mul %group, %v1 : index
  %v3 = index.add %v2, %lane : index
  %x_global = buffer.assume.memory_space<global> %x : buffer
  %x_view = buffer.view %x_global[%zero_offset] : buffer -> view<[%count_b]xbf16>
  %y_global = buffer.assume.memory_space<global> %y : buffer
  %y_view = buffer.view %y_global[%zero_offset] : buffer -> view<[%count_b]xbf16>
  %v4 = index.cmp ult, %v3, %count_b : index
  scf.if %v4 {
    %v5 = index.rem %v3, %dim : index
    %v7 = index.div %dim, %v6 : index
    %v8 = index.cmp ult, %v5, %v7 : index
    %v9 = index.add %v5, %v7 : index
    %v10 = index.sub %v5, %v7 : index
    %v11 = scf.select %v8, %v9, %v10 : index
    %v12 = index.div %v3, %dim : index
    %v13 = index.div %v12, %heads : index
    %v15 = index.rem %v5, %v7 : index
    %v16 = index.cast %v15 : index to i32
    %v17 = scalar.sitofp %v16 : i32 to f32
    %v18 = scalar.mulf %v14, %v17 : f32
    %v19 = index.cast %dim : index to i32
    %v20 = scalar.sitofp %v19 : i32 to f32
    %v21 = scalar.divf %v18, %v20 : f32
    %v22 = index.cast %v13 : index to i32
    %v23 = scalar.sitofp %v22 : i32 to f32
    %v24 = scalar.powf<afn> %theta, %v21 : f32
    %v25 = scalar.mulf %v23, %v24 : f32
    %v26 = scalar.cosf<afn> %v25 : f32
    %v27 = scalar.fptrunc %v26 : f32 to bf16
    %v28 = scalar.extf %v27 : bf16 to f32
    %v29 = scalar.sinf<afn> %v25 : f32
    %v30 = scalar.fptrunc %v29 : f32 to bf16
    %v31 = scalar.extf %v30 : bf16 to f32
    %v34 = scf.select %v8, %v32, %v33 : f32
    %v35 = index.assume %v3 [range(%v3, 0, 1073741824), lt(%v3, %count_b)] : index
    %v36 = view.load %x_view[%v35] : view<[%count_b]xbf16> -> bf16
    %v37 = scalar.extf %v36 : bf16 to f32
    %v38 = scalar.mulf %v37, %v28 : f32
    %v39 = scalar.fptrunc %v38 : f32 to bf16
    %v40 = scalar.extf %v39 : bf16 to f32
    %v41 = index.sub %v3, %v5 : index
    %v42 = index.add %v41, %v11 : index
    %v43 = index.assume %v42 [range(%v42, 0, 1073741824), lt(%v42, %count_b)] : index
    %v44 = view.load %x_view[%v43] : view<[%count_b]xbf16> -> bf16
    %v45 = scalar.extf %v44 : bf16 to f32
    %v46 = scalar.mulf %v34, %v45 : f32
    %v47 = scalar.mulf %v46, %v31 : f32
    %v48 = scalar.fptrunc %v47 : f32 to bf16
    %v49 = scalar.extf %v48 : bf16 to f32
    %v50 = scalar.addf %v40, %v49 : f32
    %v51 = scalar.fptrunc %v50 : f32 to bf16
    %v52 = index.assume %v3 [range(%v3, 0, 1073741824), lt(%v3, %count_b)] : index
    view.store %v51, %y_view[%v52] : bf16, view<[%count_b]xbf16>
  }
  kernel.return
}
